}

# Stops with an error message and a non-zero exit status.
# The message goes to the log (stdout is sunk there) and also to stderr, so the
# user sees it without -v and pipelines/CI see the failure.
end_pantera <- function(message) {
  msg <- paste0(
    format(Sys.time(), "%y-%m-%d:%H:%M:%S"),
    " \u001b[95;1;1m[panteraGA ",
    pantera_version,
    "]\u001b[0m ",
    "\u001b[33;101;1m",
    "\u2639 ",
    "\u001b[0m : ",
    message,
    "\n"
  )
  logging <- sink.number() > 0
  verbose <- exists("opt", envir = globalenv()) && isTRUE(get("opt", envir = globalenv())$verbose)
  if (logging) cat(msg)                               # into pantera.log (and the screen with -v)
  if (!logging || !verbose) cat(msg, file = stderr()) # on screen, once
  quit(save = "no", status = 1)
}

### Detection of small, degraded TIR

# Anchored local alignment of a vs b: like Smith-Waterman, but an alignment may only
# START within the first `max_start` bases of both sequences (it can end anywhere).
# This makes terminal repeats compete only with other terminal candidates, instead of
# losing to a higher-scoring internal repeat further in.
sw_anchored <- function(a, b, max_start = 10, match = 2, mismatch = -3, gap = 5) {
  a <- strsplit(a, "")[[1]]; b <- strsplit(b, "")[[1]]
  n <- length(a); m <- length(b)
  H <- matrix(-Inf, n + 1, m + 1)        # H[i+1, j+1]: best score of an alignment ending at a[i], b[j]
  SI <- matrix(0L, n + 1, m + 1); SJ <- matrix(0L, n + 1, m + 1)
  for (i in 0:min(n, max_start)) for (j in 0:min(m, max_start)) {
    H[i + 1, j + 1] <- 0; SI[i + 1, j + 1] <- i + 1L; SJ[i + 1, j + 1] <- j + 1L   # allowed starts
  }
  best <- 0; bi <- 0; bj <- 0
  for (i in 1:n) for (j in 1:m) {
    d <- H[i, j] + if (a[i] == b[j] && a[i] != "N") match else mismatch
    u <- H[i, j + 1] - gap; l <- H[i + 1, j] - gap
    v <- max(H[i + 1, j + 1], d, u, l)      # H[i+1, j+1] is 0 where a new start is allowed
    if (v > H[i + 1, j + 1]) {
      if (v == d) { SI[i + 1, j + 1] <- SI[i, j]; SJ[i + 1, j + 1] <- SJ[i, j] }
      else if (v == u) { SI[i + 1, j + 1] <- SI[i, j + 1]; SJ[i + 1, j + 1] <- SJ[i, j + 1] }
      else { SI[i + 1, j + 1] <- SI[i + 1, j]; SJ[i + 1, j + 1] <- SJ[i + 1, j] }
      H[i + 1, j + 1] <- v
    }
    if (H[i + 1, j + 1] > best) { best <- H[i + 1, j + 1]; bi <- i; bj <- j }
  }
  list(score = best, start_a = SI[bi + 1, bj + 1], start_b = SJ[bi + 1, bj + 1],
       end_a = bi, end_b = bj)
}

# Scores of anchored local alignments (as sw_anchored) of every row of A (a matrix of
# single characters, one sequence per row) against b. Only the scores: all rows are
# aligned at once, one alignment row at a time. With a linear gap penalty, the left
# gaps in a row are max over k <= j of (D[k] - gap * (j - k)), computed in log2(m)
# doubling steps.
sw_anchored_scores <- function(A, b, max_start = 10, match = 2, mismatch = -3, gap = 5) {
  b <- strsplit(b, "")[[1]]
  r <- nrow(A); n <- ncol(A); m <- length(b)
  start_cols <- (0:m) <= max_start
  H <- matrix(ifelse(start_cols, 0, -Inf), r, m + 1, byrow = TRUE)
  M <- matrix(0, r, m)                                   # best score so far per cell
  shifts <- 2^(0:max(0, ceiling(log2(m + 1)) - 1))
  for (i in seq_len(n)) {
    hit <- outer(A[, i], b, "==") & A[, i] != "N"
    s <- mismatch + (match - mismatch) * hit
    D <- H - gap                                         # up
    D[, -1] <- pmax(D[, -1], H[, -(m + 1)] + s)          # diagonal
    if (i <= max_start) D[, start_cols] <- pmax(D[, start_cols], 0)   # new starts
    D[, 1] <- if (i <= max_start) 0 else -Inf            # column 0
    for (sh in shifts) {                                 # left gaps
      if (sh > m) break
      D[, (sh + 1):(m + 1)] <- pmax(D[, (sh + 1):(m + 1)], D[, 1:(m + 1 - sh)] - gap * sh)
    }
    H <- D
    M <- pmax(M, H[, -1, drop = FALSE])
  }
  apply(M, 1, max)
}

# Integer seed for an element's random draws, from its sequence and --seed: the same
# sequence and seed always give the same draws, whatever other elements there are.
seq_seed <- function(s) {
  v <- as.numeric(utf8ToInt(s))
  base <- if (exists("opt", envir = globalenv())) get("opt", envir = globalenv())$seed else 1
  as.integer((sum(v * ((seq_along(v) - 1) %% 9973 + 1)) + base * 1000003) %% 2147483647)
}

# Terminal inverted repeat finder for degraded TIRs.
# Aligns the first `win` bp with the reverse complement of the last `win` bp, allowing the
# alignment to start only within `max_gap` bp of both ends, and tests its score against
# shuffled copies of the left end (same base composition), aligned the same way.
# With n_null = 100 the smallest possible p-value is 1/101.
find_terminal_tir <- function(s, win = 50, max_gap = 10, n_null = 100, min_len = 8) {
  n <- nchar(s)
  if (n < 2 * win) win <- n %/% 2
  left <- substr(s, 1, win)
  right <- rc(substr(s, n - win + 1, n))
  hit <- sw_anchored(left, right, max_start = max_gap)
  len <- hit$end_a - hit$start_a + 1
  if (hit$score <= 0 || len < min_len)
    return(data.table(tir_len = 0, tir_lgap = NA_real_, tir_rgap = NA_real_, tir_p = 1))
  lchars <- strsplit(left, "")[[1]]
  # The shuffles are seeded from this element's own sequence (and --seed), so its
  # result does not depend on the other elements, their order or -T
  old_seed <- get0(".Random.seed", envir = globalenv(), inherits = FALSE)
  on.exit(if (is.null(old_seed)) rm(".Random.seed", envir = globalenv())
          else assign(".Random.seed", old_seed, envir = globalenv()))
  set.seed(seq_seed(s))
  # The shuffles are drawn in the same order as when they were aligned one by one,
  # and only their scores are needed, so they are all aligned at once
  shuffled <- matrix(unlist(lapply(seq_len(n_null), function(k) sample(lchars))),
                     nrow = n_null, byrow = TRUE)
  null <- sw_anchored_scores(shuffled, right, max_start = max_gap)
  data.table(tir_len = len, tir_lgap = hit$start_a - 1, tir_rgap = hit$start_b - 1,
             tir_p = (sum(null >= hit$score) + 1) / (n_null + 1))
}


# 3' tail detector: the longest short tandem repeat (unit 1-6 bp, polyA = unit 1)
# ending within `max_offset` bp of the 3' end of the sequence. Periodicity is scored
# position by position (base i equal to base i+unit), so point mutations in the tail
# are tolerated: the tail must be at least `min_frac` periodic, start and end on a
# periodic position, and span at least 3 units and `min_len` bp. On ties between unit
# sizes the smallest unit is kept (a polyA is also periodic with unit 2, 3, ...).
detect_tail <- function(s, win = 80, max_unit = 6, min_len = 12, max_offset = 10, min_frac = 0.85) {
  none <- list(tail_len = 0L, tail_motif = "", tail_offset = NA_integer_)
  s <- toupper(s)
  n <- nchar(s)
  x <- strsplit(substr(s, max(1, n - win + 1), n), "")[[1]]
  L <- length(x)
  best <- none
  for (u in seq_len(max_unit)) {
    if (L <= u + min_len) next
    m <- x[1:(L - u)] == x[(1 + u):L] & x[1:(L - u)] != "N"     # m[i]: x[i] repeats at x[i+u]
    for (off in 0:max_offset) {
      b <- L - off                                              # candidate last tail base
      if (b - u < 1 || !m[b - u]) next                          # tail must end on a periodic base
      mm <- rev(m[1:(b - u)])                                   # walk leftwards from the end
      frac <- cumsum(mm) / seq_along(mm)
      k <- suppressWarnings(max(which(frac >= min_frac & mm)))
      if (!is.finite(k)) next
      len <- k + u
      if (len >= max(min_len, 3 * u) && len > best$tail_len) {
        a <- b - len + 1
        units <- vapply(seq(a, b - u + 1, by = u), function(i) paste(x[i:(i + u - 1)], collapse = ""), "")
        motif <- names(which.max(table(units)))
        for (d in seq_len(u - 1)) {                             # report the minimal period:
          if (u %% d == 0 && motif == strrep(substr(motif, 1, d), u / d)) { motif <- substr(motif, 1, d); break }
        }                                                       # "AAAAA" -> "A", "AGAAGA" -> "AGA"
        best <- list(tail_len = len, tail_motif = motif, tail_offset = off)
      }
    }
  }
  best
}


# Converts from dna to binDNA format
reformatDNA <- function(dna) {
  temp <- matrix(as.character(dna),
                 nrow = (length(row.names(dna))),
                 dimnames = dimnames(dna))
  temp <- apply(temp, 1, function(x) {
    paste0(x, collapse = "")
  })
  return(temp)
}

# Aligns DNA sequences with mafft: the same command ips::mafft built, run directly.
# seqs: DNAbin list. Returns a DNAbin matrix; names as written by mafft ("_R_"
# prefix for sequences it reversed). Temporary files are named with the process
# ID, so parallel workers never share one.
run_mafft <- function(seqs, method = "auto", maxiterate = 0, op = 1.53, ep = 0.123,
                      options = "--adjustdirection", threads = 1) {
  fin <- tempfile(pattern = paste0("mafft_in_", Sys.getpid(), "_"), fileext = ".fas")
  fout <- tempfile(pattern = paste0("mafft_out_", Sys.getpid(), "_"), fileext = ".fas")
  on.exit(unlink(c(fin, fout)))
  ape::write.FASTA(seqs, fin)
  cmd <- paste("mafft", "--quiet", paste0("--", method), "--maxiterate", maxiterate,
               "--op", op, "--ep", ep, paste(options, collapse = " "),
               "--thread", threads, shQuote(fin), ">", shQuote(fout))
  status <- system(cmd)
  if (status != 0 || !file.exists(fout) || file.info(fout)$size <= 1) {
    stop("mafft failed (exit status ", status, ")")
  }
  ape::read.dna(fout, format = "fasta")
}

# Reads a cd-hit .clstr file: one row per sequence (name with ">", as in the
# FASTA), with its cluster number. Read line by line: fread(fill = TRUE) guessed
# the number of columns from a sample of lines and, when the sample held only
# single-sequence clusters, silently stopped at the first line with more fields,
# dropping the remaining cluster members.
read_clstr <- function(f) {
  cl <- readLines(f)
  hdr <- startsWith(cl, ">Cluster")
  mem <- !hdr & nzchar(cl)
  data.table(name = sub("\\.\\.\\..*$", "", sub("^[^>]*", "", cl[mem])),
             clus = cumsum(hdr)[mem])
}

# Flank lengths (lx, rx) of segments by name, as reported by svfind.
# Falls back to svfind_flank (the -x given to svfind) for names not in the table.
seg_flank_lengths <- function(names) {
  if (nrow(seg_flanks) == 0) {
    return(data.table(lx = rep(svfind_flank, length(names)), rx = rep(svfind_flank, length(names))))
  }
  fl <- seg_flanks[data.table(name = names), on = "name", mult = "first", .(lx, rx)]
  fl[is.na(lx), lx := svfind_flank]
  fl[is.na(rx), rx := svfind_flank]
  fl
}

# Case for aligned segments: flanks in lowercase, the insertion in uppercase.
# Names are as in the alignment: mafft's "_R_" prefix marks copies it reversed,
# whose left and right flanks are therefore swapped. Only letters change case;
# gaps and the alignment columns are untouched.
case_flanks <- function(names, aligned) {
  bare <- sub("^_R_", "", gsub(">", "", names))
  reversed <- startsWith(gsub(">", "", names), "_R_")
  fl <- seg_flank_lengths(paste0(">", bare))
  left <- ifelse(reversed, fl$rx, fl$lx)
  right <- ifelse(reversed, fl$lx, fl$rx)
  mapply(function(s, l, r) {
    ch <- strsplit(toupper(s), "")[[1]]
    pos <- which(ch != "-")
    n <- length(pos)
    if (n == 0) return(paste0(ch, collapse = ""))
    l <- min(l, n)
    r <- min(r, n)
    if (l > 0) ch[pos[1:l]] <- tolower(ch[pos[1:l]])
    if (r > 0) ch[pos[(n - r + 1):n]] <- tolower(ch[pos[(n - r + 1):n]])
    paste0(ch, collapse = "")
  }, aligned, left, right, USE.NAMES = FALSE)
}

# Clusters segments with cd-hit-est. Temporary files go to folder `dir`.
cdhit2 <- function(sequences, threshold, dir) {
  tseqs <- copy(sequences)
  # make.names: sequence names contain the genome path from the list (e.g. "dir/genome.fa"),
  # and a "/" in the temporary file name makes cd-hit fail
  base <- make.names(paste0(stri_rand_strings(1, 12, '[A-Z]'),gsub(">","",tseqs[1]$name), collapse=""))
  fname <- file.path(dir, base)
  clname <- file.path(dir, paste0("cl", base))
  # Cluster on the insertions only: remove each segment's own flanks
  fl <- seg_flank_lengths(tseqs$name)
  tseqs[, seq := substr(seq, fl$lx + 1, nchar(seq) - fl$rx)]
  wfasta(tseqs[,1:2],fname)
  system(paste0("cd-hit-est -G 0 -A 40 -n 8 -g 1 -T 1 -aL 0.8 -aS 0.9 -d 0 -i ", shQuote(fname),
                " -c ", threshold, " -o ", shQuote(clname)), ignore.stdout = T)
  hitcl <- read_clstr(paste0(clname, ".clstr"))
  unlink(c(fname, paste0(clname, ".clstr"), clname))
  hitcl[,name:=gsub("\\.\\.\\.","",name)]
} 

# Get number of instances by genome for each TE
getgenomes <- function(input_string, genomes) {
  n <- length(genomes)
  values_str <- gsub("^#|#", "", input_string)
  numbers <- strsplit(values_str, "\\s*---\\s*")[[1]]
  keys <- numbers[seq(1, length(numbers), by = 2)]
  vals <- as.numeric(numbers[seq(2, length(numbers), by = 2)])
  result <- data.table(matrix(0, nrow = 1, ncol = n))
  colnames(result) <- gsub(".*/","",genomes)
  for (i in seq_along(keys)) {
    set(result, i = 1, j = which( colnames(result) %in% keys[i]), value = vals[i])
  }
  return(result)
}




#!/usr/bin/env Rscript

# panteraGA: builds a library of transposable elements from the polymorphic
# segments found in FastGA whole genome alignments between two or more genomes.
# https://github.com/piosierra/panteraGA  (MIT licence)

pantera_version <- "1.4.1"
options(warn = 0)

# In containers (Apptainer/Singularity), /etc/localtime is often a copy of the
# host's zone file rather than a symlink. Local times are still correct, but R
# cannot name the zone and warns. Pointing TZ at the file keeps the host's local
# time and avoids the warnings. Only done when TZ is unset and /etc/localtime is
# a regular file, so normal systems are not affected.
if (!nzchar(Sys.getenv("TZ")) && file.exists("/etc/localtime") &&
    !nzchar(Sys.readlink("/etc/localtime"))) {
  Sys.setenv(TZ = ":/etc/localtime")
}


###
### Locate the installation folder (the one containing libs/ and model/).
### normalizePath() is applied to the full script path so that symlinks such as
### $PREFIX/bin/panteraGA resolve to the real install location.
### The PANTERA_HOME environment variable overrides the detected location.
###
file_arg <- grep("^--file=", commandArgs(trailingOnly = FALSE), value = TRUE)
pantera_script <- if (length(file_arg) > 0) {
  normalizePath(sub("^--file=", "", file_arg[1]))
} else {
  ""
}
pantera_home <- Sys.getenv("PANTERA_HOME",
                           unset = if (nzchar(pantera_script)) {
                             dirname(pantera_script)
                           } else {
                             getwd()
                           })



###
### Internal settings: thresholds that are not command-line options.
### Changing a value here changes the results; each one is used where its
### list is named in the code (e.g. tsd_cfg$max_len).
###

# Flank length requested from svfind (-x), on each side of an insertion. Also the
# flank length assumed for segments whose exact flanks are unknown.
svfind_flank <- 100

# Loop 1: length windows for the first clustering round
loop1_cfg <- list(
  window = 60,            # window width (bp, segment length with flanks)
  window_overlap = 30     # added on each side of a window
)

# Loop 2: clustering, alignment and consensus
loop2_cfg <- list(
  window = 300,           # window width (bp)
  window_overlap = 0,
  max_cluster = 1000,     # max sequences per cd-hit run (replaces -u in round 2)
  small_n = 100,          # clusters with fewer sequences than this, all shorter than
  small_len = 3000,       #   small_len, are aligned with L-INS-i and up to -I iterations
  cons_threshold = 0.3,   # min fraction of a column for its majority base in the consensus
  conserv_threshold = 0.8,# a column is conserved if its majority base is >= this fraction
  sat_threshold = 0.4,    #   of its bases, and >= this fraction of sequences have a base
  min_cons_len = 100,     # min consensus length (or -s, if larger)
  min_trimmed = 180       # min alignment columns outside the consensus edges; fewer means
                          #   the cluster reaches the flanks (most likely a segmental duplication)
)

# Consensus edges: extending a conserved block across gaps
edges_cfg <- list(
  small_gap = 20,         # gaps up to this many columns are always bridged
  lookahead = 1000,       # larger gaps are bridged if, within this many columns after the
  min_cluster_total = 10  #   block, at least this many conserved columns follow
)

# Target site duplications (TSD) and the search for the element edges
tsd_cfg <- list(
  max_len = 13L,          # longest TSD tested (bp); the shortest is min_len
  min_len = 2L,
  max_offset = 6L,        # max bases between an edge and its TSD copy (offset refinement)
  min_identity = 0.8,     # min identity between the two copies of a TSD
  local_composition = TRUE, # chance match probability from the flank base composition
                          #   (FALSE: 0.25 per base)
  sig_threshold = 0.1,    # max p-value for a copy's own TSD call to count
  alpha = 0.05,           # significance of the agreement between copies (corrected)
  min_support = 2L,       # min copies sharing a TSD length for it to count (and to give a motif)
  max_shift = 12,         # edges are moved up to this many columns each way
  min_core = 20,          # never shrink the element below this many columns
  adequate_support = 0.65,# min fraction of copies agreeing on a TSD before moving an edge
  collapse_below = 0.15,  # one step past a real TSD, support falls below this fraction
  strict_pval = 0.01,     # offset refinement: p-value of a "strict" TSD call
  min_strict_count = 6    #   and min number of strict calls at the same offset
)

# Classification
class_cfg <- list(
  min_prob = 0.4          # min classifier probability; below it the class is Unknown
)

# Structure rules (stats_tes): which elements pass, and reclassification.
# "gap" is the distance in bp from a terminal repeat (LTR or TIR) to the element end.
rules_cfg <- list(
  end_gap = 8,            # max gap for a terminal repeat to count as being at the ends
  ltr_min_len = 100,      # min LTR length for an element classified as LTR
  self_rep_min = 20,      # min length of an internal self-match counted in maxTR
  tandem_frac = 2.5,      # maxTR > length / tandem_frac: element mostly a repeat of itself;
  tandem_ltr_max = 100,   #   rejected if it is a LINE, or has an LTR structure and maxTR > this
  line_min_orf = 1600,    # min longest ORF for a LINE
  line_max_pa = 10,       # LINE: max distance of a polyA from an end
  line_inner_gap = 10,    # LINE: also passes if its self-match is more than this from both ends
  dup_cover = 0.98,       # duplicates: min coverage of the shorter element,
  dup_ident = 98,         #   min identity (%),
  dup_len_diff = 0.01,    #   max length difference (fraction)
  contain_cover = 0.98,   # contained elements: min fraction of their length matched
  contain_ident = 98,     #   by one hit of a longer accepted element, at min identity (%),
  contain_classes = c("LINE", "LTR", "PLE", "RC"),  # of these classes (not DNA): rejected
  anchor_cover = 0.9,     # 3'-anchored relatives: min coverage of the shorter element,
  anchor_ident = 90,      #   min identity (%),
  anchor_end = 30,        #   max distance of the match from the container's 3' end
  tir_check_gap = 10,     # TIR finder: run where BLAST found no structure, or one this far from an end
  tir_max_p = 0.01,       # TIR finder: max p-value
  dirs_min_orf = 2000,    # DIRS: min longest ORF
  dirs_max_len = 10000,   #   and max length
  sine_max_len = 500,     # SINE: max length to pass
  unknown_min_cluster = 5,# Unknown: passes with a cluster larger than this (or the kneedle cut)
  ltr_tsd_min = 4,        # LTR TSD length range, for reclassifying Unknowns as LTR
  ltr_tsd_max = 6,
  tgca_tsd_conf = 0.8,    # Unknown with TG..CA ends: min TSD confidence to become LTR
  unknown_tsd_conf = 0.3, # Unknown with an LTR: min TSD confidence to become LTR
  unknown_ltr_min_len = 150, # Unknown: min LTR length to become LTR
  sine_reco_max_len = 400,# Unknown: becomes SINE if shorter than this
  sine_reco_max_pa = 5    #   and with a polyA within this many bp of an end
)




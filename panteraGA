# Prints log messages
lx <- function(x) {
  cat(paste0(
    format(Sys.time(), "%y-%m-%d:%H:%M:%S"),
    " \u001b[95;1;1m[panteraGA ",
    pantera_version, 
    "]\u001b[0m ",
    x,
    "\n"
  ))
}

# Loads the required libraries. They are installed as dependencies by conda.
get_libs <- function() {
  pkgs <- c("getopt", "parallel", "Biostrings", "stringi",
            "ape", "xgboost", "quantmod", "data.table")
  for (p in pkgs) {
    if (!suppressPackageStartupMessages(require(p, character.only = TRUE,
                                                quietly = TRUE))) {
      stop("R package [", p, "] not found")
    }
  }
}

# Reads parameters
read_pars <- function() {

  # One row per option: long name, short flag, argument (0 none, 1 required),
  # type, and help text (with the default, which is set further below).
  options_table <- matrix(
    c("genomes",        "g", 1, "character", "File with the paths to the genomes, one per line (min 2) [required]",
      "lib_name",       "b", 1, "character", "Identifier appended to element names [required]",
      "output_folder",  "o", 1, "character", "Output folder [pantera_output]",
      "threads",        "T", 1, "integer",   "Threads [8, or the number of cores if fewer]",
      "min_size",       "s", 1, "integer",   "Min length of a polymorphic insertion, without flanks [50]",
      "max_size",       "l", 1, "integer",   "Max length of a polymorphic insertion, without flanks [30000]",
      "identity1",      "i", 1, "double",    "Identity for clustering, first round, 0.8-1 [0.90]",
      "identity2",      "y", 1, "double",    "Identity for clustering, second round, 0.8-1 [0.85]",
      "min_cluster",    "m", 1, "integer",   "Min sequences to build a consensus [3]",
      "max_cluster",    "u", 1, "integer",   "Max sequences per cluster, first round [300]",
      "min_copies",     "e", 1, "integer",   "Min copies in at least one genome for an element to be accepted [2]",
      "max_ns",         "n", 1, "double",    "Max fraction of Ns in a segment [0.001]",
      "max_cons_ns",    "c", 1, "double",    "Max fraction of Ns in a final consensus [0.02]",
      "min_polya",      "p", 1, "integer",   "Min length of a polyA tail [10]",
      "flanking",       "f", 1, "integer",   "Min length of the flanks of a segment [automatic, see -q]",
      "flank_quantile", "q", 1, "double",    "Without -f: fraction of segments with the shortest flanks to discard [0.05]",
      "anno_coverage",  "a", 1, "double",    "Min fraction of an element covered by a hit, for annotation [0.80]",
      "anno_identity",  "z", 1, "double",    "Min identity of a hit, and min length ratio hit/element, for annotation [0.80]",
      "align_iterations","I", 1, "integer",  "Max mafft refinement iterations for clusters of < 100 sequences < 3 kb; 2 is faster, changes some consensi [1000]",
      "seed",           "r", 1, "integer",   "Random seed for the TIR test; the same data and seed give the same results [1]",
      "keep_alignments","k", 0, "logical",   "Keep the FastGA alignments (.1aln)",
      "debug",          "d", 0, "logical",   "Keep intermediate files",
      "verbose",        "v", 0, "logical",   "Show log messages on screen",
      "version",        "V", 0, "logical",   "Show the version and exit",
      "help",           "h", 0, "logical",   "Show this help and exit"),
    byrow = TRUE, ncol = 5)
  spec <- options_table[, 1:4]

  opt <- getopt(spec)

  if (!is.null(opt$help)) {
    arg <- ifelse(options_table[, 3] == "1",
                  paste0("<", options_table[, 4], ">"), "")
    cat("panteraGA ", pantera_version, "\n\n",
        "Usage: panteraGA -g <genomes file> -b <library name> [options]\n\n",
        paste0(sprintf("  -%s, --%-16s %-12s %s",
                       options_table[, 2], options_table[, 1], arg, options_table[, 5]),
               collapse = "\n"),
        "\n", sep = "")
    q(status = 0)
  }

  if (!is.null(opt$version)) {
    cat("panteraGA", pantera_version, "\n")
    q(status = 0)
  }

  if (is.null(opt$genomes)) {
    stop("[--genomes|-g] missing")
  }

  if (is.null(opt$lib_name)) {
    stop("[--lib_name|-b] missing")
  }

  if (is.null(opt$output_folder)) {
    opt$output_folder <- "pantera_output"
  }

  if (is.null(opt$threads)) {
    opt$threads <- min(8, detectCores())
  } else {
    opt$threads <- min(opt$threads, detectCores())
  }

  if (is.null(opt$min_size)) {
    opt$min_size <- 50
  }

  if (is.null(opt$max_size)) {
    opt$max_size <- 30000
  }

  if (is.null(opt$identity1)) {
    opt$identity1 <- 0.90
  }

  if (is.null(opt$identity2)) {
    opt$identity2 <- 0.85
  }

  # cd-hit-est, with the word length used here (-n 8), refuses identities below 0.8
  for (o in c("identity1", "identity2")) {
    if (opt[[o]] < 0.8 || opt[[o]] > 1) {
      flag <- if (o == "identity1") "i" else "y"
      stop("[--", o, "|-", flag, "] must be between 0.8 and 1 (cd-hit-est's limit), not ", opt[[o]])
    }
  }

  if (is.null(opt$min_cluster)) {
    opt$min_cluster <- 3
  }

  if (is.null(opt$max_cluster)) {
    opt$max_cluster <- 300
  }

  if (is.null(opt$min_copies)) {
    opt$min_copies <- 2
  }

  if (is.null(opt$max_ns)) {
    opt$max_ns <- 0.001
  }

  if (is.null(opt$max_cons_ns)) {
    # Consensus Ns are ambiguous alignment columns, not assembly gaps
    opt$max_cons_ns <- 0.02
  }

  if (is.null(opt$min_polya)) {
    opt$min_polya <- 10
  }

  # Without -f, svfind is run with 100 bp flanks and the fraction -q of segments
  # with the shortest flanks is discarded. With -f, that fixed length is used.
  opt$flank_auto <- is.null(opt$flanking)
  if (opt$flank_auto) {
    opt$flanking <- 100
  }

  if (is.null(opt$flank_quantile)) {
    opt$flank_quantile <- 0.05
  }

  if (is.null(opt$anno_coverage)) {
    opt$anno_coverage <- 0.80
  }

  if (is.null(opt$anno_identity)) {
    opt$anno_identity <- 0.80
  }

  if (is.null(opt$align_iterations)) {
    opt$align_iterations <- 1000
  }
  if (opt$align_iterations < 0) {
    stop("[--align_iterations|-I] must be 0 or more")
  }

  if (is.null(opt$seed)) {
    opt$seed <- 1
  }

  if (is.null(opt$keep_alignments)) {
    opt$keep_alignments <- FALSE
  }

  if (is.null(opt$debug)) {
    opt$debug <- FALSE
  }

  if (is.null(opt$verbose)) {
    opt$verbose <- FALSE
  }

  return(opt)
}

# Reads a fasta file
ffasta <- function(f) {
  check <- file.size(f)
  if (check == 0 | is.na(check)) {
    return(data.table(name = as.character(), seq = as.character()))
  } else {
    fa_raw <- fread(f, header = F, fill = T, sep = "\n")
    fa_raw[, h := grepl(">", V1)]
    fa_oneline <- fa_raw[, .(paste0(V1, collapse = "")), by = rleid(h)]
    return(data.table(name = fa_oneline[rep(c(TRUE, FALSE), length = .N)]$V1, 
                      seq = fa_oneline[rep(c(FALSE, TRUE), length = .N)]$V1))
  }
}

# Writes a fasta file
wfasta <- function(fasta_data, f) {
  # 1. Clean path slashes and find the target directory
  f <- normalizePath(f, winslash = "/", mustWork = FALSE)
  dir_path <- dirname(f)
  
  # 2. Create the directory if it does not exist
  if (!dir.exists(dir_path)) {
    dir.create(dir_path, recursive = TRUE)
  }
  
  # 3. Safely open, write, and close the file connection
  fileconn <- file(f, open = "w")
  on.exit(close(fileconn)) # Ensures connection closes even if writing fails
  
  writeLines(t(fasta_data), fileconn)
}

# Reverse-complements an alignment file in place, keeping the columns aligned.
# Sequence names get mafft's "_R_" prefix (or lose it, if they already had it),
# so the prefix always tells which copies are shown reversed relative to the genome.
rc_alignment <- function(f) {
  a <- ffasta(f)
  a[, seq := stri_reverse(chartr("ACGTRYKMBDHVacgtrykmbdhv", "TGCAYRMKVHDBtgcayrmkvhdb", seq))]
  a[, name := ifelse(startsWith(name, ">_R_"), sub("^>_R_", ">", name), sub("^>", ">_R_", name))]
  wfasta(a, f)
}

## Original code from: https://github.com/etam4260/kneedle/blob/main/R/kneedle.R
kneedle <- function(x, y, decreasing, concave, sensitivity = 1) {
  data <- matrix(unlist(list(x, y)), ncol = 2)
  data <- data[order(data[,1], decreasing = FALSE), ]
  if(missing(decreasing)) {
    if( (data[(nrow(data)), 2] - data[1, 2]) >= 0 ) {
      decreasing = FALSE
    } else {
      decreasing = TRUE
    }
  }
  if(missing(concave)) {
    secondderiv <- diff(diff(data[, 2]) / diff(data[, 1]))
    if(mean(secondderiv) > 0) {
      concave = TRUE
    } else {
      concave = FALSE
    }
  }
  maxy <- max(y)
  miny <- min(y)
  maxx <- max(x)
  minx <- min(x)
  data[ ,1] <- (data[, 1]- min(data[, 1]))/(max(data[ ,1])- min(data[, 1]))
  data[ ,2] <- (data[, 2]- min(data[, 2]))/(max(data[ ,2])- min(data[, 2]))
  if(concave && !decreasing) {
    differ <- abs(c(data[ ,2] - data[ ,1]))
  } else if(concave && decreasing) {
    differ <- abs(c(data[ ,2] - (1 - data[ ,1])))
  } else if(!concave && !decreasing) {
    differ <- abs(c(data[ ,2] - data[ ,1]))
  } else if(!concave && decreasing) {
    differ <- abs(c(data[ ,2] - (1 - data[ ,1])))
  }
  peak.indices <- findPeaks(differ) - 1
  data <- cbind(data, differ)
  diffx = diff(data[, 1])
  T.lm.x.s <- sensitivity * mean(diffx)
  knee = NULL
  for(i in 1:length(peak.indices)) {
    T <- data[peak.indices[i] ,3] - (T.lm.x.s)
    y.value <- data[peak.indices[i] ,3]
    for(j in (peak.indices[i]):if(i+1 < length(peak.indices)) peak.indices[i+1] else length(differ)) {
      if(differ[j] < T) {
        knee = peak.indices[i];
        break;
      }
    }
    if(!is.null(knee)) {
      break;
    }
  }
  x <- ((maxx - minx) * (data[knee, 1])) + minx
  y <- ((maxy - miny) * (data[knee, 2])) + miny
  return(c(as.numeric(x),as.numeric(y)))
}

# Reads the two ONEcode files extracted from each 1aln file with svfind.
# genomes: genome file names (without folders), in the order of the alignments.
parseONEview <- function(genomes) {
  n <- length(genomes)
  lx(paste("Processing", n, "alignments"))
  ovret <- data.table(name = character(), seq = character(), lx = numeric(), rx = numeric())
  for (i in 1:n) {
    f <- aln_path(genomes, i)
    system2("svfind", args = paste0(" -x ", svfind_flank, " -s ", min(50, opt$min_size), " -f ", opt$flanking, " -a ",opt$output_folder,"/",opt$lib_name,"hapa",i," -b ",opt$output_folder,"/",opt$lib_name,"hapb",i, " ", f), stdout = FALSE, stderr = FALSE)
    if (file.size(paste0(opt$output_folder,"/",opt$lib_name,"hapa",i))>0) {
      ov <- fread(cmd = paste0("ONEview ",opt$output_folder,"/",opt$lib_name,"hapa",i), fill = T)
        if (nrow(ov)>0) {
          ov[,f:="a"]
          sequences <- ov[V1=="S",2:3][,V2:=as.numeric(V2)]
          file <- ov[V1=="S",f]
          overhangs <- ov[V1=="Q",2:3][,V2:=as.numeric(V2)]
          flanks <- ov[V1=="F",2:3][,V2:=as.numeric(V2)][,V3:=as.numeric(V3)]
          name <- ov[V1=="I",3]
          # X: flank bases svfind added on each side of the insertion (up to -x, fewer at contig ends)
          xflank <- ov[V1=="X",2:3][,V2:=as.numeric(V2)][,V3:=as.numeric(V3)]
          variant <- ov[V1=="V",3:5][,V4:=as.numeric(V4)][,V5:=as.numeric(V5)]
          source <- ov[V1=="B",3:5][,V4:=as.numeric(V4)][,V5:=as.numeric(V5)]
          ovall <- cbind(file,name,variant[,1:3], source[,1:3],flanks[,1:2], sequences[,1:2], overhangs[,1:2], xflank[,1:2])
          colnames(ovall) <- c("file","name","v_name", "v_start","v_end","s_name", "s_start","s_end", "flank_l", "flank_r", "seq_len","seq","ov_len","overhang", "lx", "rx")
          # Length of the insertion itself, without the flanks
          ovall[, ins_len := seq_len - lx - rx]
          ovall[, name:=paste0(genomes[i],"#",v_name,":",v_start,"-",v_end),.I]
          lx(paste("Total segments in 1aln =", nrow(ovall)))
          ## Remove segments that map to the same spot, we remove the last digit to account for small missmatches in the breakpoint
          ovall[,ins_point :=paste0(file,"-",s_name,":",substr(s_start,1,nchar(s_start)-1),"-",substr(s_end,1,nchar(s_end)-1))]
          ovall <- ovall[!(ins_point %in% ovall$ins_point[duplicated(ovall$ins_point)]) ]  
          ovall <- ovall[ins_len >= opt$min_size & ins_len <= opt$max_size]
          lx(paste("Total segments filtered =", nrow(ovall)))

          if (opt$debug) {
            fwrite(ovall[, .(flank_l, flank_r, seq_len)],
                   paste0(opt$output_folder, "/flanks_", i, ".tsv"), sep = "\t")
          }
          
          if (opt$flank_auto) {
            mf <- pmin(ovall$flank_l, ovall$flank_r)
            tmpflanking <- if (length(mf) > 0 && opt$flank_quantile > 0) {
              as.numeric(quantile(mf, opt$flank_quantile, type = 1))
            } else {
              0
            }
          } else {
            tmpflanking <- opt$flanking
          }
          lx(paste("Flanking sequences cutpoint = ", tmpflanking))
          ovcut <- ovall[flank_l>=tmpflanking & flank_r>=tmpflanking]
          ### Remove all but one copy when the same segment can map to several places.
          ovall <-ovcut[order(file,v_name,v_start)]
          ovall[,ov:=shift(v_start,-1), by=v_name]
          ovall[,ov:=ov-v_end]
          ovall[is.na(ov) ,ov:=1]
          ovall[ov < -seq_len ,ov:=1]
          ovall <- ovall[ov>0]
          unlink(list.files(path = opt$output_folder,pattern = paste0(opt$lib_name,"hap*"),full.names = T))
          ovall[, Ns := nchar(seq) - nchar(gsub("N", "", seq, ignore.case = TRUE))]
          ovall <- ovall[Ns <= (nchar(seq) * opt$max_ns)]
          lx(paste("Number of valid Ns segments =", nrow(ovall)))
          ovall[, name := paste0(">", name), .I]
          ovret <- rbind(ovret, ovall[, c("name", "seq", "lx", "rx")])
        }
      
    }
  }
  return(ovret)
}


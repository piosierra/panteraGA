cleanup <- function() {
  
  lx("Library successfully created.")
  unlink(outf("alignments", "X.CONS*"))
  unlink(outf("loop_1"), recursive = TRUE)
  unlink(outf("loop_2"), recursive = TRUE)
  unlink(outf(c("orfs.tbl", "pantera_lib_0.fa", "all_segments_flanks.tsv",
                "segments_candidates.fa", "temp.orfs")))
  unlink(outf("*consensi*"))
  if (opt$keep_alignments == FALSE) {
    unlink(outf("*.1aln"))
  }
  lx(paste0(   "\u001b[32;2m",
               "\u263A",
               "\u001b[0m : ","End of process."))
}



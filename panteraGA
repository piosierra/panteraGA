# Extracts the polymorphic segments and writes them to all_segments.fa. Returns
# their flank lengths (name, lx, rx), also written to all_segments_flanks.tsv.
read_poly <- function(genomes) {
  segments <- parseONEview(genomes)
  segments[, seq := toupper(seq)]
  wfasta(segments[, c("name", "seq")], outf("all_segments.fa"))
  flanks <- unique(segments[, .(name, lx, rx)], by = "name")
  fwrite(flanks, outf("all_segments_flanks.tsv"), sep = "\t")
  flanks
}

# Stops the run if any parallel task failed: an R error, or a worker that ended
# without a result (for example killed for using too much memory). Every task
# returns a non-NULL value, so NULL means it did not finish.
# labels: optional description of each task, to name the first failure.
check_tasks <- function(res, what, labels = NULL) {
  bad <- which(vapply(res, function(x) is.null(x) || inherits(x, "try-error"), TRUE))
  if (length(bad) > 0) {
    first <- res[[bad[1]]]
    msg <- if (inherits(first, "try-error")) trimws(as.character(first))
           else "the worker stopped without a result (out of memory?)"
    where <- if (!is.null(labels)) paste0(" (", labels[bad[1]], ")") else ""
    end_pantera(paste0(what, ": ", length(bad), " of ", length(res),
                       " parallel tasks failed. First failure", where, ": ", msg))
  }
  invisible(res)
}

# Genome name for file names: the file name without folders or the extension
# (.fa, .fasta, .fna, .fas, each optionally .gz)
genome_stem <- function(g) {
  sub("\\.(fa|fasta|fna|fas)$", "", sub("\\.gz$", "", basename(g), ignore.case = TRUE),
      ignore.case = TRUE)
}

# FastGA alignment i of the ring (genome i against the next one), named after both
# genomes: <genome i>_<genome i+1>.1aln in the output folder
aln_path <- function(genomes, i) {
  j <- if (i < length(genomes)) i + 1 else 1
  outf(paste0(genome_stem(genomes[i]), "_", genome_stem(genomes[j]), ".1aln"))
}

# Runs FastGA on two genomes and stops the run if no alignment was produced
run_fastga <- function(i, a, b, aln, tempf) {
  lx(paste0("Aligning ", gsub(".*/", "", a), " <-> ", gsub(".*/", "", b)))
  # Alignments from runs before 1.4.1 were named pantera<i>.1aln: reuse them
  old <- outf(paste0("pantera", i, ".1aln"))
  if (!file.exists(aln) && file.exists(old)) {
    lx(paste0("Using ", basename(old), " (renamed to ", basename(aln), ")"))
    file.rename(old, aln)
  }
  if (!file.exists(aln)) {
    dir.create(tempf, showWarnings = FALSE)
    status <- system(paste0("FastGA -1:", aln, " -P", tempf, " ", a, " ", b))
    unlink(tempf, recursive = TRUE)
    if (status != 0 || !file.exists(aln) || file.size(aln) == 0) {
      unlink(aln)
      end_pantera(paste0("FastGA failed aligning ", a, " and ", b, " (exit status ", status, ")"))
    }
  }
}

# Checks the genome list and makes the FastGA alignments. Returns the genome paths.
make_alignments <- function(glist) {
  # Check if file exists
  if (!file.exists(glist)) {
    end_pantera(paste0("File not found: ", glist))
  }
  genomes <- readLines(glist)
  genomes <- trimws(genomes[nzchar(trimws(genomes))])
  lgenomes <- length(genomes)
  if (lgenomes<2) {
    end_pantera(paste0("At least two genomes needed in ", glist))
  }
  missing <- genomes[!file.exists(genomes)]
  if (length(missing) > 0) {
    end_pantera(paste0("Genome file(s) in ", glist, " not found: ", paste(missing, collapse = ", ")))
  }
  dups <- unique(genomes[duplicated(genomes)])
  if (length(dups) > 0) {
    end_pantera(paste0("Genome(s) listed more than once in ", glist, ": ", paste(dups, collapse = ", ")))
  }
  # Genomes are told apart by their file names (segment names, counts per genome,
  # alignment and annotation files), so these must differ
  stems <- genome_stem(genomes)
  same <- genomes[stems %in% stems[duplicated(stems)]]
  if (length(same) > 0) {
    end_pantera(paste0("Genome files in ", glist, " must have different names, without folders and extensions: ",
                       paste(same, collapse = ", ")))
  }
  tempf <- paste0(opt$output_folder,"/tmp",stri_rand_strings(1, 12, '[A-Z]'))
  # Ring of pairwise alignments: 1 vs 2, 2 vs 3, ..., last vs 1
  for (i in 1:lgenomes) {
    run_fastga(i, genomes[i], genomes[if (i < lgenomes) i + 1 else 1], aln_path(genomes, i), tempf)
  }
  return(genomes)
}

# First pass, finds repeats but does not try to generate any consensus.  
find_repeats <- function() {
  process_zone <- function(zone) {
    start <- as.numeric(zone[1]) - zones_interval_overlap
    end <- as.numeric(zone[2]) + zones_interval_overlap
    if (start != end) {
      # If they have the same value they were processed in another zone
      if (nrow(segments_unique[len >= start][len <= end])> 0) {
        segment_u <- segments_unique[len >= start][len <= end]
        segment_u <- segment_u[!duplicated(segment_u)]
        if (nrow(segment_u) >= opt$min_cluster)  {
          segment_sets <- split(segment_u, 
                                rep(1:(nrow(segment_u) %/% opt$max_cluster +1), 
                                    length.out = nrow(segment_u), 
                                    each = ceiling(nrow(segment_u) / 
                                                     (nrow(segment_u) %/% 
                                                        opt$max_cluster +1))))
          candidates <- data.table(name = as.character(), 
                                   seq = as.character())
          for (ss in 1:length(segment_sets)) {
            sg <- segment_sets[[ss]]
            if (nrow(sg)>1) {
              sg_clus <- cdhit2(sg, opt$identity1, loop_dir)
              sg_clus[,n:=.N,clus]
              sg_clus <- sg_clus[n>=opt$min_cluster]
              
              candidates <- rbindlist(list(candidates, 
                                           sg[name %in% sg_clus$name, 
                                              c("name", "seq")]))
            }
          }
          if (nrow(candidates) > 0) {
            wfasta(candidates, file.path(loop_dir, paste0("candidates_", start, "_", end, ".fa")))
          }
        }
      }
    }
    return(0)
  }
  
  zones_interval <- loop1_cfg$window
  zones_interval_overlap <- loop1_cfg$window_overlap
  round <- 1
  lx(paste("Reading data for round:", round))
  segments_unique <- ffasta(outf("all_segments.fa"))
  lx(paste("Total Unique segments:", nrow(segments_unique)))
  segments_unique <- segments_unique[!duplicated(segments_unique)]
  segments_unique[, len := nchar(seq)]
  segments_unique <- segments_unique[order(-len)]
  lx(paste("Total Unique segments no dups:", nrow(segments_unique)))
  lx(paste("Starting loop:", round))
  lx(paste("Processing:", nrow(segments_unique), "segments"))
  ins_len <- segments_unique$len - rowSums(seg_flank_lengths(segments_unique$name))
  lx(paste("Largest insertion:", max(ins_len)))
  lx(paste("Smallest insertion:", min(ins_len)))
  loop_dir <- outf(paste0("loop_", round))
  dir.create(loop_dir, showWarnings = FALSE)
  z <-
    seq(
      min(segments_unique$len),
      max(segments_unique$len) + zones_interval,
      zones_interval
    )
  if (length(z) < 2) {
    zones <-
      list(data.frame(
        start = min(segments_unique$len),
        end = max(segments_unique$len)
      ))
  } else {
    zones <- asplit(data.frame(start = z[-length(z)], end = z[-1]), 1)
  }
  
  lx(paste("Processing:", length(zones), "windows"))
  loop_exit <- mclapply(
    rev(zones),
    function(z) { process_zone(z); TRUE },
    mc.preschedule = FALSE,
    mc.cores = opt$threads
  )
  check_tasks(loop_exit, "Loop 1",
              vapply(rev(zones), function(z) paste0("window ", z[1], "-", z[2]), ""))
  
  file.rename(outf("all_segments.fa"), outf(paste0("pantera_lib_", round - 1, ".fa")))
  system(paste0("cd ", shQuote(loop_dir), " && cat candidates*.fa > ../segments_candidates.fa"))
}

find_largest_orfs <- function(dna_sequence) {
  
  # Standardize input
  dna <- toupper(trimws(dna_sequence))
  
  find_orfs_in_strand <- function(seq, strand = "+") {
    orfs <- list()
    n <- nchar(seq)
    
    for (frame in 1:3) {
      i <- frame
      while (i <= n - 2) {
        codon <- substr(seq, i, i + 2)
        
        if (codon == "ATG") {
          start <- i
          j <- i + 3
          found_stop <- FALSE
          
          while (j <= n - 2) {
            stop_codon <- substr(seq, j, j + 2)
            if (stop_codon %in% c("TAA", "TAG", "TGA")) {
              end <- j + 2
              length <- end - start + 1
              
              if (strand == "+") {
                orfs <- append(orfs, list(list(
                  start = start, end = end,
                  length = length, frame = frame, strand = strand
                )))
              } else {
                # Convert back to original sequence coordinates
                orig_end   <- n - start + 1
                orig_start <- n - end + 1
                orfs <- append(orfs, list(list(
                  start = orig_start, end = orig_end,
                  length = length, frame = frame, strand = strand
                )))
              }
              found_stop <- TRUE
              i <- j + 3  # resume after stop codon
              break
            }
            j <- j + 3
          }
          
          if (!found_stop) break
        } else {
          i <- i + 3
        }
      }
    }
    orfs
  }
  
  # Find ORFs on both strands
  all_orfs <- c(
    find_orfs_in_strand(dna, "+"),
    find_orfs_in_strand(rc(dna), "-")
  )
  
  if (length(all_orfs) == 0) {
    return(NULL)
  }
  
  # Sort by length descending and return top 3
  lengths <- sapply(all_orfs, function(o) o$length)
  top3    <- all_orfs[order(lengths, decreasing = TRUE)[1:min(3, length(all_orfs))]]
  
  # Format as data frame
  result <- do.call(rbind, lapply(top3, function(o) {
    data.frame(start = o$start, end = o$end,
               length = o$length, frame = o$frame,
               strand = o$strand, stringsAsFactors = FALSE)
  }))
  
  rownames(result) <- paste0("ORF_", seq_len(nrow(result)))
  return(result)
}

three_orfs <- function(seq) {
  orfs <- find_largest_orfs(seq)
  if (is.null(orfs)) {
    return(data.table(orf1 = 0,
                      orf2 = 0,
                      orf3 = 0,
                      strand = "+"))
  } else {
    return(data.table(orf1 = orfs[1,3],
                      orf2 = orfs[2,3],
                      orf3 = orfs[3,3],
                      strand = orfs[1,5]))
  }
}


get_highest_letter <- function(mat, cons_threshold = loop2_cfg$cons_threshold) {
  priority <- c("A", "C", "G", "T", "-")
  
  apply(mat, 2, function(col) {
    fifth_val <- col[5]
    top_four  <- col[1:4]
    top_sum   <- sum(top_four)
    all_sum <- sum(col)
    
    if (fifth_val < top_sum) {
      max_top <- max(top_four)
      if (max_top >= all_sum* cons_threshold) {
        tied <- rownames(mat)[1:4][top_four == max_top]
        # Ties: a transition (A/G or C/T) keeps A or C, the base first in the priority
        # order; any tie involving a transversion, or more than two bases, becomes N.
        if (length(tied) == 1) tied
        else if (setequal(tied, c("A", "G"))) "A"
        else if (setequal(tied, c("C", "T"))) "C"
        else "N"
      } else {
        "N"
      }
    } else {
      # Original behaviour when row 5 is >= sum of others
      max_val <- max(col)
      tied    <- rownames(mat)[col == max_val]
      priority[priority %in% tied][1]
    }
  })
}

### Loop 2: aligning one cluster, its consensus, edges and TSD

# Aligns a cluster with mafft. mafft --auto aligns clusters of < 100 sequences whose
# longest sequence is < 3 kb with L-INS-i and up to 1000 refinement iterations. Same
# method here, with at most -I iterations (default 1000, identical to --auto); other
# clusters keep mafft --auto's choice.
align_cluster <- function(seqs, seq_lengths) {
  small <- length(seqs) < loop2_cfg$small_n && max(seq_lengths) < loop2_cfg$small_len
  run_mafft(seqs,
            method = if (small) "localpair" else "auto",
            maxiterate = if (small) opt$align_iterations else 0,
            ep = 0.123,
            options = c("--adjustdirection"),
            threads = 1)
}

# Per-column summary of an alignment (alim: one aligned string per sequence, gaps
# as "-"). Returns the base count matrix, a string with "1" for each conserved
# column and "0" otherwise, and the full consensus (one character per column, gaps
# included). All-gap columns are kept, so positions in the string are alignment columns.
column_consensus <- function(alim) {
  nseqs <- length(alim)
  cMatrix <- Biostrings::consensusMatrix(Biostrings::DNAStringSet(alim))
  dtMatrix <- as.data.table(matrix(unlist(cMatrix), nrow = nrow(cMatrix)))
  saturation <- unlist(lapply(dtMatrix[1:4], sum)) / nseqs
  conserv <- unlist(lapply(dtMatrix[1:4], max)) / (saturation * nseqs)
  consstring <- paste0(as.numeric(conserv >= loop2_cfg$conserv_threshold &
                                    saturation >= loop2_cfg$sat_threshold), collapse = "")
  cons <- paste0(get_highest_letter(cMatrix[c(1:4, 16), ], loop2_cfg$cons_threshold), collapse = "")
  list(cMatrix = cMatrix, consstring = consstring, cons = cons)
}

# Conserved columns in a row needed to start an element, by number of sequences
min_run_length <- function(x) {
  ifelse(x == 2, 9,
         ifelse(x == 3, 7,
                ifelse(x == 4, 6,
                       ifelse(x <= 8, 5,
                              ifelse(x <= 13, 4,
                                     ifelse(x <= 20, 3, 2))))))
}

# Raw element edges from conservation alone: the start of the first run of conserved
# columns long enough for this number of sequences, and the end of the block it
# belongs to. Gaps of up to small_gap columns (single-base dropouts inside a solid
# block) are always bridged. Larger gaps are bridged only if enough conservation
# follows within `lookahead` columns: this crosses real internal insertions of any
# length (needed for an LTR/Gypsy element with a ~700 bp low-conservation stretch)
# but not a lone coincidental match downstream (a LINE alignment had an unrelated
# 6 bp conserved stretch ~220 bp past its true end). Returns NULL without such a run.
raw_edges <- function(consstring, nseqs) {
  run_len <- min_run_length(nseqs)
  cons_s <- stri_locate_first_fixed(consstring, paste0(rep(1, run_len), collapse = ""))[1]
  if (is.na(cons_s)) return(NULL)
  x <- as.numeric(strsplit(consstring, "")[[1]])
  rl <- rle(x)
  run_ends   <- cumsum(rl$lengths)
  run_starts <- run_ends - rl$lengths + 1
  solid <- which(rl$values == 1 & rl$lengths >= run_len)
  j <- match(solid[which(run_starts[solid] <= cons_s & run_ends[solid] >= cons_s)], solid)
  cons_e <- run_ends[solid[j]]
  while (j < length(solid)) {
    gap <- run_starts[solid[j + 1]] - run_ends[solid[j]] - 1
    if (gap > edges_cfg$small_gap) {
      window_end <- run_ends[solid[j]] + edges_cfg$lookahead
      idx_ahead <- solid[solid > solid[j]]
      idx_ahead <- idx_ahead[run_starts[idx_ahead] <= window_end]
      if (sum(rl$lengths[idx_ahead]) < edges_cfg$min_cluster_total) break
    }
    j <- j + 1
    cons_e <- run_ends[solid[j]]
  }
  c(cons_s, cons_e)
}

## ---- TSD caller ---------------------------------------------------------------
## Tests whether each copy's own left-flank tail matches its own right-flank head,
## for lengths tsd_cfg$min_len to max_len. This needs no assumption about what the
## TSD looks like: a family-fixed motif (Tc1/Mariner's "TA", PiggyBac's "TTAA"), a
## partly degenerate one (CACTA/hAT-style target sites) and a variable-content but
## fixed-length target (most hAT elements) all show up the same way; only the
## statistics across copies differ.
##
## The caller only looks at the K = max_len + max_offset bases next to an edge, so for
## each edge position those bases are extracted once, as an nseqs x K matrix, cached,
## and all lengths are scored for all copies with vectorised comparisons.

# Number of flank bases next to an edge that the TSD caller uses
tsd_K <- function() tsd_cfg$max_len + tsd_cfg$max_offset

# Cached flank bases of an alignment. left_tail(cs): the last K ungapped bases before
# column cs, per sequence (left-padded with NA). right_head(ce): the first K ungapped
# bases after column ce (right-padded with NA).
tsd_flank_bases <- function(alim) {
  K <- tsd_K()
  tail_cache <- new.env()
  head_cache <- new.env()
  left_tail <- function(cs) {
    key <- as.character(cs)
    v <- tail_cache[[key]]
    if (is.null(v)) {
      v <- t(vapply(alim, function(s) {
        x <- if (cs > 1) strsplit(gsub("-", "", substr(s, 1, cs - 1)), "")[[1]] else character(0)
        x <- tail(x, K)
        c(rep(NA_character_, K - length(x)), x)
      }, character(K), USE.NAMES = FALSE))
      assign(key, v, envir = tail_cache)
    }
    v
  }
  right_head <- function(ce) {
    key <- as.character(ce)
    v <- head_cache[[key]]
    if (is.null(v)) {
      v <- t(vapply(alim, function(s) {
        x <- strsplit(gsub("-", "", substr(s, ce + 1, nchar(s))), "")[[1]]
        x <- head(x, K)
        c(x, rep(NA_character_, K - length(x)))
      }, character(K), USE.NAMES = FALSE))
      assign(key, v, envir = head_cache)
    }
    v
  }
  list(left_tail = left_tail, right_head = right_head)
}

# Chance match probability per base outside the edges cs..ce. With
# tsd_cfg$local_composition, from the base composition of the flanks (column counts
# in cMatrix); otherwise 0.25. Returns a function of (cs, ce).
tsd_p0 <- function(cMatrix) {
  cum_acgt <- t(apply(cMatrix[c("A", "C", "G", "T"), , drop = FALSE], 1, cumsum))
  function(cs, ce) {
    if (!tsd_cfg$local_composition) return(0.25)
    cnt <- (if (cs > 1) cum_acgt[, cs - 1] else 0) + cum_acgt[, ncol(cum_acgt)] - cum_acgt[, ce]
    if (sum(cnt) == 0) return(0.25)
    sum((cnt / sum(cnt))^2)
  }
}

# Per-copy best TSD: for each length, compare the last x bases of the left flank with
# the first x bases of the right flank (after skipping offl/offr bases next to the
# edges), keep lengths with >= min_identity, and take the length with the smallest
# binomial p-value (the first one on ties).
call_tsd <- function(Lt, Rh, offl = 0L, offr = 0L, p0 = 0.25,
                     min_len = tsd_cfg$min_len, min_identity = tsd_cfg$min_identity) {
  tsd_max <- tsd_cfg$max_len
  K <- tsd_K()
  n <- nrow(Lt)
  max_x <- pmin(tsd_max, rowSums(!is.na(Lt)) - offl, rowSums(!is.na(Rh)) - offr)
  best_p <- rep(Inf, n)
  best_x <- rep(NA_integer_, n)
  for (xx in min_len:tsd_max) {
    ok <- max_x >= xx
    if (!any(ok)) break
    nm <- rowSums(Lt[, (K - offl - xx + 1):(K - offl), drop = FALSE] ==
                    Rh[, (offr + 1):(offr + xx), drop = FALSE], na.rm = TRUE)
    pv <- stats::pbinom(nm - 1, size = xx, prob = p0, lower.tail = FALSE)
    upd <- ok & (nm / xx >= min_identity) & (pv < best_p)
    best_p[upd] <- pv[upd]
    best_x[upd] <- xx
  }
  list(tsd_len = best_x, pval = signif(best_p, 3))
}

# Most frequent significant TSD length (the longest one on ties), the fraction of ALL
# copies that agree on it, and which copies those are.
summarize_tsd <- function(calls, sig_threshold = tsd_cfg$sig_threshold) {
  sig <- which(!is.na(calls$tsd_len) & calls$pval <= sig_threshold)
  if (length(sig) == 0) return(list(modal_len = NA_integer_, modal_conf = 0, rows = integer(0)))
  counts <- tabulate(calls$tsd_len[sig], nbins = tsd_cfg$max_len)
  modal_len <- max(which(counts == max(counts)))
  list(modal_len = modal_len,
       modal_conf = round(max(counts) / length(calls$tsd_len), 2),
       rows = sig[calls$tsd_len[sig] == modal_len])
}

# IUPAC consensus of the TSD copies supporting the modal length
tsd_motif <- function(summ, Lt, Rh, offl = 0L, offr = 0L, min_support = tsd_cfg$min_support) {
  K <- tsd_K()
  k <- summ$modal_len
  if (is.na(k) || length(summ$rows) < min_support) return("")
  l_side <- apply(Lt[summ$rows, (K - offl - k + 1):(K - offl), drop = FALSE], 1, paste, collapse = "")
  r_side <- apply(Rh[summ$rows, (offr + 1):(offr + k), drop = FALSE], 1, paste, collapse = "")
  Biostrings::consensusString(Biostrings::DNAStringSet(c(r_side, l_side)),
                              ambiguityMap = Biostrings::IUPAC_CODE_MAP, shift = 0L, width = NULL)
}

## Is the agreement between copies more than chance? A copy "has" a TSD of length L
## by chance with probability q_L (>= min_identity of L positions matching at the
## chance match probability p0): about 1/16 for 2 bp, 1/64 for 3-5 bp, much less
## for longer ones. The chance that k or more of n copies agree on one length is then
## binomial. This is a p-value for ONE edge position and ONE length; callers multiply
## it by the number of lengths tried and, in the shift search, by the number of edge
## positions tried. Without that, a 3-copy cluster finds a chance 2 bp "TSD" (2 of 3
## copies) somewhere in the ~600 candidates almost every time.
## A length found in a single copy is not a duplication shared by the family: one
## long chance match (e.g. 12 bp, q ~ 1e-6) would otherwise pass easily. Lengths
## shared by fewer than tsd_cfg$min_support copies get p = 1.
tsd_pvalue <- function(summ, p0, n, min_identity = tsd_cfg$min_identity) {
  L <- summ$modal_len
  if (is.na(L) || length(summ$rows) < tsd_cfg$min_support) return(1)
  q <- stats::pbinom(ceiling(min_identity * L - 1e-9) - 1, L, p0, lower.tail = FALSE)
  stats::pbinom(length(summ$rows) - 1, n, q, lower.tail = FALSE)
}

## ---- Edge search: are the raw edges right? -------------------------------------
## A TSD is not random flanking DNA (the transposase selects and duplicates it), so it
## can be pulled into, or trimmed out of, the raw conservation-based edges. Both edges
## are moved independently by up to tsd_cfg$max_shift columns, and the TSD caller is
## run at each position. A shift is trusted only when enough copies agree on a
## significant TSD there, and among those the SMALLEST shift is taken: target motifs
## are often short tandem-repeat units and element termini are often AT-rich, so
## several shifts within a repetitive stretch can score equally well (any even shift
## inside "TATATA..." still gives a perfect 2 bp match). There is no real maximum to
## chase there, and chasing one slides into the element.
##
## "Smallest adequate shift" can stop one base short of the true edge (seen on a
## CACTA-type element whose terminal base coincides with the edge of a 5 bp target
## motif: the smallest shift found a real but incomplete 2 bp match, one base short of
## a perfect 3 bp one). Past a real, discrete TSD, support collapses sharply (26/26
## copies matching, one base later 0/26); inside a repeat it stays high as the match
## re-phases (6/6 copies kept matching several bases out). So the edge is moved one
## more step only if that step is well supported AND support collapses one step beyond.
##
## Returns the chosen candidate: edges (cons_s, cons_e), shifts (ds, de), the
## per-copy calls, their summary and p0.
search_edges <- function(cons_s_raw, cons_e_raw, ncols, nseqs, fl, p0_for) {
  tsd_max <- tsd_cfg$max_len
  adequate_support <- tsd_cfg$adequate_support
  min_core <- tsd_cfg$min_core   # never shrink the core below this many columns
  score_candidate <- function(cs, ce) {
    p0 <- p0_for(cs, ce)
    calls <- call_tsd(fl$left_tail(cs), fl$right_head(ce), p0 = p0)
    summ <- summarize_tsd(calls)
    list(score = summ$modal_conf, calls = calls, summary = summ, p0 = p0)
  }
  candidate <- function(ds, de) {
    cs <- cons_s_raw + ds
    ce <- cons_e_raw + de
    c(list(ds = ds, de = de, cons_s = cs, cons_e = ce), score_candidate(cs, ce))
  }

  all_results <- list(`0_0` = candidate(0, 0))
  shift_range <- -tsd_cfg$max_shift:tsd_cfg$max_shift
  for (ds in shift_range) {
    if (cons_s_raw + ds < 1) next
    for (de in shift_range) {
      if (cons_e_raw + de > ncols || (cons_e_raw + de) - (cons_s_raw + ds) < min_core) next
      if (ds == 0 && de == 0) next
      all_results[[paste(ds, de, sep = "_")]] <- candidate(ds, de)
    }
  }

  ## An inward shift turns element columns into flank. A TSD pulled into the raw edge
  ## can only account for as many columns as the TSD is long, so candidates that trim
  ## more than that on either side are rejected. Without this, the self-complementary
  ## core of a TIR (e.g. ...GC|...|GC... inside GGGGGC...GCCCCC) is shared by every
  ## copy and scores as a perfect, but false, 2 bp "TSD".
  inward_ok <- function(r) {
    k <- r$summary$modal_len
    !is.na(k) && max(r$ds, 0) <= k && max(-r$de, 0) <= k
  }
  ## The raw edges come from conservation alone, before any TSD is looked at, so a
  ## TSD there is one test (corrected only for the lengths tried). A TSD found by
  ## moving the edges is corrected for every edge position tried. Using the full
  ## correction at the raw edges too would reject a real 5 bp TSD in a small cluster
  ## and accept the exact 4 bp match that a 1 bp shift always produces from it
  ## (4 of its 5 bases), growing the element by 1 bp.
  n_tests <- length(all_results) * (tsd_max - 1L)     # edge positions x TSD lengths
  significant <- function(r) {
    m <- if (r$ds == 0 && r$de == 0) tsd_max - 1L else n_tests
    tsd_pvalue(r$summary, r$p0, nseqs) * m <= tsd_cfg$alpha
  }
  eligible <- Filter(function(r) r$score >= adequate_support && inward_ok(r) && significant(r),
                     all_results)
  best <- if (length(eligible) == 0) {
    all_results[["0_0"]]
  } else {
    eligible[[which.min(vapply(eligible, function(r) abs(r$ds) + abs(r$de), numeric(1)))]]
  }

  # Cliff-validated extension by one step
  directions <- list(c(-1, 0), c(1, 0), c(0, -1), c(0, 1))
  extension <- NULL
  for (dir in directions) {
    step1 <- all_results[[paste(best$ds + dir[1], best$de + dir[2], sep = "_")]]
    if (is.null(step1) || step1$score < adequate_support || !inward_ok(step1) || !significant(step1)) next
    step2_ds <- best$ds + 2 * dir[1]; step2_de <- best$de + 2 * dir[2]
    step2_cs <- cons_s_raw + step2_ds; step2_ce <- cons_e_raw + step2_de
    step2 <- if (step2_cs >= 1 && step2_ce <= ncols && step2_ce - step2_cs >= min_core) {
      cand <- all_results[[paste(step2_ds, step2_de, sep = "_")]]
      if (is.null(cand)) score_candidate(step2_cs, step2_ce) else cand
    } else {
      list(score = 1)   # ran off the end of the sequence: a cliff can't be confirmed, so don't extend
    }
    if (step2$score < tsd_cfg$collapse_below) {
      if (is.null(extension) || step1$score > extension$score) extension <- step1
    }
  }
  if (!is.null(extension)) best <- extension
  best
}

## ---- Offset refinement (variable-content, fixed-length TSDs) -------------------
## The edge search only tests matches flush against the edges. Some real TSDs sit a
## few bases away from the edge on one side (seen on an Unknown bat repeat whose
## right-side TSD copy sat 1-4 bases into the flank). This does NOT move the edges;
## it only improves the TSD reported.
##
## It needs a different bar than the edge search: a family-fixed motif shows up in
## nearly every copy, but a variable-content, fixed-length TSD (most hAT elements) is
## a different sequence at every insertion, so only copies that haven't diverged past
## recognition still show it, often well under half of them. Offsets are judged by an
## absolute COUNT of highly significant, length-consistent matches, and among offsets
## reaching that count the smallest total offset is taken (same repeat-plateau risk as
## in the edge search). Returns the TSD to report: calls, summary, offsets and p0.
refine_tsd_offset <- function(best, Lt, Rh, p0_final) {
  tsd <- list(calls = best$calls, summary = best$summary, offl = 0L, offr = 0L, p0 = best$p0)
  strict_pval <- tsd_cfg$strict_pval
  offset_candidates <- list()
  for (offl in 0:tsd_cfg$max_offset) {
    for (offr in 0:tsd_cfg$max_offset) {
      calls_off <- call_tsd(Lt, Rh, offl, offr, p0 = p0_final)
      strict <- which(!is.na(calls_off$tsd_len) & calls_off$pval <= strict_pval)
      if (length(strict) == 0) next
      cnt <- max(tabulate(calls_off$tsd_len[strict], nbins = tsd_cfg$max_len))
      if (cnt >= tsd_cfg$min_strict_count) {
        offset_candidates[[paste(offl, offr, sep = "_")]] <- list(
          offl = offl, offr = offr, count = cnt, calls = calls_off,
          summary = summarize_tsd(calls_off))
      }
    }
  }
  if (length(offset_candidates) > 0) {
    best_offset <- offset_candidates[[which.min(vapply(offset_candidates,
                                                       function(r) r$offl + r$offr, numeric(1)))]]
    baseline_strict_count <- sum(!is.na(tsd$calls$tsd_len) & tsd$calls$pval <= strict_pval)
    if (best_offset$count > baseline_strict_count) {
      tsd <- list(calls = best_offset$calls, summary = best_offset$summary,
                  offl = best_offset$offl, offr = best_offset$offr, p0 = p0_final)
    }
  }
  tsd
}

# Element edges and TSD for an aligned cluster. Returns the edges (alignment columns)
# and the TSD length, confidence, motif and p-value (corrected for the lengths tried);
# with no significant TSD, length 0, confidence 0, no motif (not NA, so the consensus
# name and the rules downstream work) and p-value NA.
find_edges_tsd <- function(alim, cMatrix, cons_s_raw, cons_e_raw, ncols) {
  nseqs <- length(alim)
  fl <- tsd_flank_bases(alim)
  p0_for <- tsd_p0(cMatrix)
  best <- search_edges(cons_s_raw, cons_e_raw, ncols, nseqs, fl, p0_for)
  Lt <- fl$left_tail(best$cons_s)
  Rh <- fl$right_head(best$cons_e)
  tsd <- refine_tsd_offset(best, Lt, Rh, p0_for(best$cons_s, best$cons_e))
  summ <- tsd$summary
  ## Report a TSD only if the agreement at the final edges is more than chance (one
  ## edge position, so corrected only for the number of lengths tried). Otherwise it
  ## would still feed the TSD-based reclassification rules.
  pval <- min(1, tsd_pvalue(summ, tsd$p0, nseqs) * (tsd_cfg$max_len - 1L))
  if (pval > tsd_cfg$alpha) {
    summ <- list(modal_len = NA_integer_, modal_conf = 0, rows = integer(0))
  }
  motif <- tsd_motif(summ, Lt, Rh, tsd$offl, tsd$offr)
  if (is.na(summ$modal_len)) {
    return(list(cons_s = best$cons_s, cons_e = best$cons_e, len = 0, conf = 0, motif = "",
                pval = NA_real_))
  }
  list(cons_s = best$cons_s, cons_e = best$cons_e,
       len = summ$modal_len, conf = summ$modal_conf, motif = motif, pval = signif(pval, 3))
}

# Copies per genome of a cluster, as "#genome1---n1---genome2---n2#"
gen_counts <- function(names) {
  gc <- table(gsub(">", "", gsub("#.*", "", names)))
  paste0("#", paste0(c(rbind(names(gc), gc)), collapse = "---"), "#")
}

# Writes a cluster's alignment, flanks in lowercase and the insertion in uppercase
write_cluster_alignment <- function(alim, cons_name) {
  out <- data.table(name = names(alim), seq = case_flanks(names(alim), alim))
  out[, name := paste0(">", gsub(">", "", name))]
  wfasta(out, outf("alignments", paste0(substr(make.names(cons_name), 1, 36), ".maf")))
}

# Aligns one cluster from round 2 and builds its consensus. Returns the consensus
# (NULL if none), where it goes (the window's consensi file and its rank there), and timing.
process_cluster_2 <- function(job) {
  seqs_clust <- job$seqs
  t_job <- Sys.time()
  result <- NULL
  mafft_s <- NA_real_
  aln_len <- NA_integer_
  # What every exit returns
  done <- function() {
    list(consensus = result, file = job$file, rank = job$rank,
         timing = data.table(win_start = job$start, win_end = job$end, set = job$ss, cluster = job$u,
                             n_seqs = nrow(seqs_clust), mean_len = round(mean(nchar(seqs_clust$seq))),
                             max_len = max(nchar(seqs_clust$seq)), aln_len = aln_len,
                             seconds = round(mafft_s, 2),
                             total_s = round(as.numeric(difftime(Sys.time(), t_job, units = "secs")), 2),
                             t_start = round(as.numeric(t_job), 2), t_end = round(as.numeric(Sys.time()), 2),
                             pid = Sys.getpid()))
  }
  clust_temp <- strsplit(seqs_clust$seq, "")
  names(clust_temp) <- seqs_clust$name
  seqs <- ape::as.DNAbin(clust_temp)
  if (length(seqs) < 2) return(done())   # a single sequence (only possible with -m 1): no consensus

  t0 <- Sys.time()
  ali <- align_cluster(seqs, lengths(clust_temp))
  mafft_s <- as.numeric(difftime(Sys.time(), t0, units = "secs"))
  aln_len <- if (is.matrix(ali)) ncol(ali) else NA_integer_
  alim <- reformatDNA(ali)

  cc <- column_consensus(alim)
  edges <- raw_edges(cc$consstring, length(seqs))
  if (is.null(edges)) return(done())   # no conserved block: no consensus for this cluster
  et <- find_edges_tsd(alim, cc$cMatrix, edges[1], edges[2], nchar(cc$cons))

  cons <- substr(cc$cons, et$cons_s, et$cons_e)
  trimmed <- nchar(cc$cons) - nchar(cons)     # alignment columns outside the edges
  cons <- gsub("-", "", cons)
  nam <- paste0(">CONS-", job$start, "-", job$end, "-", job$u, "-",
                nchar(cons), "_clus", length(clust_temp), "_tsdl", et$len, "_tsdc", et$conf,
                "_tsdm", et$motif, "_tsdp", et$pval, "_gens", gen_counts(seqs_clust$name), "@@")
  # Clusters that reach the flanks are most likely segmental duplications
  if (nchar(cons) >= max(loop2_cfg$min_cons_len, opt$min_size) &&
      trimmed > loop2_cfg$min_trimmed) {
    result <- data.table(name = nam, seq = cons)
    write_cluster_alignment(alim, nam)
  }
  done()
}

# Second pass. Cluster and generate consensus.
cluster_results <- function() {

  # Round 2, step 1 (per length window): clusters the segments and returns one job
  # per cluster to align. The alignment is done per cluster (process_cluster_2), so
  # that all clusters share the workers instead of each window aligning its own.
  process_zone_2 <- function(zone) {
    start <- as.numeric(zone[1]) - zones_interval_overlap
    end <- as.numeric(zone[2]) + zones_interval_overlap
    # Timing (written to loop2_*_timing.tsv in the output folder)
    t_win <- Sys.time()
    n_seg <- 0
    cdhit_s <- 0
    jobs <- list()
    on.exit(if (opt$debug) {
      fwrite(data.table(win_start = start, win_end = end, n_segments = n_seg,
                        n_clusters = length(jobs), cdhit_s = round(cdhit_s, 2),
                        total_s = round(as.numeric(difftime(Sys.time(), t_win, units = "secs")), 2),
                        t_start = round(as.numeric(t_win), 2), t_end = round(as.numeric(Sys.time()), 2),
                        pid = Sys.getpid()),
             file.path(loop_dir, paste0("timing_win_", start, "_", end, ".tsv")), sep = "\t")
    }, add = TRUE)
    if (start != end) {
      if (nrow(segments_unique[len >= start][len <= end])> 0) {
        segment_u <- segments_unique[len >= start][len <= end]
        segment_u <- segment_u[!duplicated(segment_u)]
        n_seg <- nrow(segment_u)
        if (nrow(segment_u) >= opt$min_cluster)  {
          segment_sets <- split(segment_u, 
                                rep(1:(nrow(segment_u) %/% max_cluster +1), 
                                    length.out = nrow(segment_u), 
                                    each = ceiling(nrow(segment_u) / 
                                                     (nrow(segment_u) %/%
                                                        max_cluster +1))))
          
          for (ss in 1:length(segment_sets)) {
            sg <- segment_sets[[ss]]
            if (nrow(sg)>1) {
              t0 <- Sys.time()
              sg_clus <- cdhit2(sg, opt$identity2, loop_dir)
              cdhit_s <- cdhit_s + as.numeric(difftime(Sys.time(), t0, units = "secs"))
              sg_clus[,n:=.N,clus]
              sg_clus <- sg_clus[n>=opt$min_cluster]
              
              if ( nrow(sg_clus) > 0) {
                for (u in unique(sg_clus$clus)) {
                  seqs_clust <- sg[name %in% unlist(sg_clus[clus==u]$name)]
                  jobs[[length(jobs) + 1]] <- list(start = start, end = end, ss = ss, u = u,
                                                   seqs = seqs_clust, rank = length(jobs) + 1,
                                                   file = paste0("consensi_", start, "_", end, ".fa"))
                }
              } 
            }
          }
        }
      }
    }
    return(jobs)
  }
  
  zones_interval <- loop2_cfg$window
  zones_interval_overlap <- loop2_cfg$window_overlap
  max_cluster <- loop2_cfg$max_cluster
  loop_dir <- outf("loop_2")
  segments_unique <- ffasta(outf("segments_candidates.fa"))
  if (nrow(segments_unique) > 0) {
    lx(paste("Total Unique segments:", nrow(segments_unique)))
    segments_unique <- segments_unique[!duplicated(segments_unique$seq)]
    segments_unique[, len := nchar(seq)]
    segments_unique <- segments_unique[order(-len)]
    lx(paste("Total Unique segments no dups:", nrow(segments_unique)))
    lx(paste("Starting loop 2"))
    lx(paste("Processing:", nrow(segments_unique), "segments"))
    ins_len <- segments_unique$len - rowSums(seg_flank_lengths(segments_unique$name))
    lx(paste("Largest insertion:", max(ins_len)))
    lx(paste("Smallest insertion:", min(ins_len)))
    dir.create(loop_dir, showWarnings = FALSE)
    dir.create(outf("alignments"), showWarnings = FALSE)
    z <-
      seq(
        min(segments_unique$len),
        max(segments_unique$len) + zones_interval,
        zones_interval
      )
    if (length(z) < 2) {
      zones <-
        list(data.frame(
          start = min(segments_unique$len),
          end = max(segments_unique$len)
        ))
    } else {
      zones <- asplit(data.frame(start = z[-length(z)], end = z[-1]), 1)
    }
    
    # Step 1: cluster each window (in parallel); each window returns its clusters as jobs
    zone_out <- mclapply(
      rev(zones),
      process_zone_2,
      mc.preschedule = FALSE,
      mc.cores = opt$threads
    )
    check_tasks(zone_out, "Loop 2 clustering",
                vapply(rev(zones), function(z) paste0("window ", z[1], "-", z[2]), ""))
    jobs <- unlist(zone_out, recursive = FALSE)
    lx(paste("Clusters to align:", length(jobs)))
    if (length(jobs) > 0) {
      # Step 2: align all clusters (in parallel), largest first so that no long
      # alignment is left running alone at the end
      cost <- vapply(jobs, function(j) nrow(j$seqs) * mean(nchar(j$seqs$seq)), 0)
      jobs <- jobs[order(-cost)]
      res <- mclapply(jobs, process_cluster_2, mc.preschedule = FALSE, mc.cores = opt$threads)
      check_tasks(res, "Loop 2 alignment",
                  vapply(jobs, function(j) paste0("window ", j$start, "-", j$end, ", cluster ", j$u,
                                                  ", ", nrow(j$seqs), " sequences"), ""))
      # Consensi go to one file per window, in the same order as when each window
      # aligned its own clusters, so all_consensi.fa is unchanged
      cons <- rbindlist(lapply(res, function(r) {
        if (is.null(r$consensus)) NULL else cbind(r$consensus, file = r$file, rank = r$rank)
      }))
      if (nrow(cons) > 0) {
        setorder(cons, file, rank)
        for (f in unique(cons$file)) wfasta(cons[file == f, .(name, seq)], file.path(loop_dir, f))
      }
      if (opt$debug) {
        fwrite(rbindlist(lapply(res, `[[`, "timing")), outf("loop2_mafft_timing.tsv"), sep = "\t")
      }
    }
    # Timing of the clustering step, per window (only with -d)
    tf <- list.files(loop_dir, pattern = "^timing_win_", full.names = TRUE)
    if (opt$debug && length(tf) > 0) {
      tt <- rbindlist(lapply(tf, fread))
      setorder(tt, win_start)
      fwrite(tt, outf("loop2_window_timing.tsv"), sep = "\t")
      lx(paste("Loop 2 timing written to loop2_window_timing.tsv and loop2_mafft_timing.tsv"))
    }
    system(paste0("cd ", shQuote(loop_dir), " && cat consen*.fa >> ../all_consensi.fa"))
  }
}

# Classify TE models


classify_tes <- function() {
  final <- ffasta(outf("all_consensi.fa"))
  final <- final[!duplicated(final$seq)]
  final <- final[order(-nchar(seq))]
  final[, `:=`(
    cluster  = as.numeric(gsub("_tsdl.*", "", gsub(".*_clus", "", name))),
    tsd_l    = as.numeric(gsub("_tsdc.*", "", gsub(".*_tsdl", "", name))),
    tsd_c    = as.numeric(gsub("_tsdm.*", "", gsub(".*_tsdc", "", name))),
    tsd_m    = gsub("_tsdp.*", "", gsub(".*_tsdm", "", name)),
    tsd_p    = suppressWarnings(as.numeric(gsub("_gens.*", "", gsub(".*_tsdp", "", name)))),
    gencount = gsub("@@.*", "", gsub(".*_gens", "", name)),
    aln_file = paste0(substr(make.names(name), 1, 36), ".maf")
  )]
  final[, name := paste0(">", opt$lib_name, "_", .I)]
  file <- outf(paste0(opt$lib_name, "-consensi.fa"))
  wfasta(final[, c("name", "seq")], file)
  lx(paste("Final consensi: ", nrow(final)))
  lx("Reading orfs")
  # BLAST: -mt_mode 1 splits the work between threads by query. The default splits by
  # database, which with one small database leaves most threads idle. Same hits.
  system(
    paste0(
      "getorf -sequence ", shQuote(file),
      " --outseq ", shQuote(outf("temp.orfs")), " -minsize 100 >/dev/null 2>&1; blastp -num_threads ", opt$threads, " -mt_mode 1",
      " -query ", shQuote(outf("temp.orfs")), " -db ",
      shQuote(file.path(pantera_home, "libs/RepeatPeps.lib")),
      " -outfmt 6 -evalue 1e-1 > ", shQuote(outf("orfs.tbl"))
    )
  )
  lx("Reading data")
  orfs <- fread(outf("orfs.tbl"), header = F)
  result <- data.table()
  if (nrow(orfs) > 0) {
    types <-
      read.table(file.path(pantera_home, "model/typesnames"),
                 sep = "\n")
    types <- types$V1
    features <-
      read.table(file.path(pantera_home, "model/featurenames"),
                 sep = "\n")
    features <- features$V1
    xgb.fit <-
      xgb.load(file.path(pantera_home, "model/xgbmodel.ubj"))
    lx("Processing")
    orfs[, V1 := gsub("_[0-9]*$", "", V1)]
    orfs[, prot := gsub(".*#", "", V2)]
    
    orfs_table <-
      dcast(
        orfs,
        V1 ~ prot,
        value.var = "V12",
        fun.agg = function(x) {
          suppressWarnings(max(x))
        }
      )
    orfs_table[is.na(orfs_table), ] <- 0
    orfs_table[orfs_table == -Inf, ] <- 0
    
    names <- orfs_table$V1
    orfs_table$V1 <- NULL
    
    colnames(orfs_table) <- make.names(colnames(orfs_table))
    if (sum(!(colnames(orfs_table) %in% features)) > 0) {
      orfs_table[, colnames(orfs_table)[!(colnames(orfs_table) %in% features)] :=
                   NULL]
    }
    orfs_table[, features[!(features %in% colnames(orfs_table))] := 0]
    setcolorder(orfs_table, features)
    xgb.pred2 = predict(xgb.fit, orfs_table)
    xgb.pred2 = as.data.frame(xgb.pred2)
    colnames(xgb.pred2) = types
    xgb.pred2$prediction = apply(xgb.pred2, 1, function(x)
      colnames(xgb.pred2)[which.max(x)])
    xgb.pred2$prob = apply(xgb.pred2[1:ncol(xgb.pred2) - 1], 1, function(x)
      max(x))
    
    result <-
      data.table(
        name = paste0(">", names),
        Prediction = xgb.pred2$prediction,
        Probability = xgb.pred2$prob
      )
  }
  
  lx("Merge")
  if (nrow(result) > 0) {
    final <- merge(final, result, by = "name", all.x = TRUE, sort = FALSE)
  } else {
    final[, `:=`(Prediction = NA_character_, Probability = NA_real_)]
  }
  # Keep the classifier's own call for curators, whatever its probability
  final[, `:=`(hom_class = fifelse(is.na(Prediction), "none", Prediction),
               hom_prob  = fifelse(is.na(Probability), 0, round(Probability, 3)))]
  final[is.na(Prediction) | is.na(Probability) | Probability < class_cfg$min_prob, Prediction := "Unknown"]
  final <- final[order(-nchar(seq))]
  # Working name: unique id + class. Final names are set at the end of stats_tes().
  final[, name := paste0(name, "#", Prediction)]
  fwrite(final, paste0(file, ".statspre"), sep = "\t")
  return(final[, c("name", "seq", "cluster", "tsd_l", "tsd_c", "tsd_m", "tsd_p", "gencount", "aln_file",
                   "hom_class", "hom_prob")])
}


# Obtain structural stats from TE models and recover or filter some.


# final: the classified consensi (from classify_tes); genomes: genome names.
stats_tes <- function(final, genomes) {
  lx("Stats start")
  tes <- final[, c("name", "seq", "cluster", "tsd_l", "tsd_c", "tsd_m", "tsd_p", "gencount", "aln_file",
                   "hom_class", "hom_prob")]
  temp <- outf(paste0("temp", make.names(paste0(opt$lib_name, "-consensi.fa"))))
  dir.create(temp)
  tmp_tes <- file.path(temp, "tmp-tes")
  lente <- nchar(tes$seq)
  tes$lente <- lente
  orfs_res <- mclapply(tes$seq, three_orfs, mc.cores = opt$threads)
  check_tasks(orfs_res, "ORF search", tes$name)
  orfs_tes <- rbindlist(orfs_res)
  tes <- cbind(tes, orfs_tes)
  lx(paste("Flipping", nrow(tes[strand == "-"]), "sequences"))
  tes[, flipped := strand == "-"]
  tes[strand == "-", seq := rc(seq)]
  tes$strand <- NULL
  
  ## 3' tails: polyA or a short tandem repeat (see detect_tail). Checked at both ends:
  ## elements are oriented by their longest ORF, so for LINEs the 3' end is the right
  ## end, but SINEs have no ORF and can end up either way round.
  t3 <- rbindlist(lapply(tes$seq, detect_tail))
  t5 <- rbindlist(lapply(tes$seq, function(s) detect_tail(rc(s))))
  tes[, `:=`(tail3_motif = t3$tail_motif, tail3_len = t3$tail_len,
             tail5_motif = t5$tail_motif, tail5_len = t5$tail_len)]
  wfasta(tes[, c("name", "seq")], tmp_tes)
  system(paste0("makeblastdb -in ", shQuote(tmp_tes), " -dbtype nucl 1> /dev/null"))
  contain_pairs <- data.table(small = character(), big = character())
  te_data <- fread(cmd = paste0("blastn -query ", shQuote(tmp_tes), " -db ", shQuote(tmp_tes),
                                " -task blastn -num_threads ",
                                opt$threads, " -mt_mode 1",
                                " -evalue 500 -outfmt 6 -word_size 11 -gapopen 4 -gapextend 1 -reward 1 -penalty -1"), header = F)
  if (nrow(te_data) > 0) {
    colnames(te_data) <- c("qseqid", "sseqid", "pident", "length", "mismatch",
                           "gapopen", "qstart", "qend", "sstart", "send",
                           "evalue", "bitscore")
    te_data_mix <- te_data[qseqid != sseqid] # Non self matches, to deal with later
    te_data_rep <- te_data[qseqid == sseqid & length > rules_cfg$self_rep_min &
                             (qstart != sstart | qend != send)][, .(N = .N, maxRep = max(length)), qseqid] # large self matches that are not trivial. To filter with MaxRep.
    te_data <- te_data[!(qseqid == sseqid & qstart == sstart & qend == send)] # Self matches that are not the whole element, to check for TIR and LTR
    ### TIR, LTR detection
    te_data <- te_data[qseqid == sseqid]
    te_data[, len := abs(qend - qstart)]
    te_data <- te_data[order(qstart)][order(-len)]
    te_data <- merge(te_data,
                     tes[, c("name", "lente", "orf1", "orf2", "orf3")]
                     [, name := gsub(">", "", name)], by.x = "qseqid", by.y = "name")
    te_data[, lgap := .(min(qstart, qend, sstart, send) - 1), by = 1:nrow(te_data)]
    te_data[, rgap := .(lente - max(qstart, qend, sstart, send)), by = 1:nrow(te_data)]
    
    te_data[, check := ((qend + qstart - lente) / 2) * ((send + sstart - lente) / 2) < 0,
            by = 1:nrow(te_data)]  ### Is each match at one side of the center?
    te_data <- te_data[check == T]
    te_data[, check_type := ((qend - qstart) * (send - sstart)) < 0, by = 1:nrow(te_data)]
    te_data[, tgap := lgap + rgap]
    te_data <- te_data[order(tgap)][, .SD[1], qseqid]
    te_data$type <- "LTR"
    te_data[check_type == T, type := "TIR"]
    ### TIR, LTR detection END
    
    # Mark as PASS LTR and TIR elements matching their class.
    good_ltr <- te_data[grepl("#LTR", qseqid) & type == "LTR" & lgap < rules_cfg$end_gap & rgap < rules_cfg$end_gap & length > rules_cfg$ltr_min_len]$qseqid
    good_tir <- te_data[grepl("#DNA", qseqid) & type == "TIR" & lgap < rules_cfg$end_gap & rgap < rules_cfg$end_gap]$qseqid
    
    tes <- merge(tes[, name := gsub(">", "", name)],
                 te_data[, c("qseqid", "length", "lgap", "rgap", "type")],
                 by.x = "name", by.y = "qseqid", all.x = T)
    tes[is.na(type), rgap := 0]
    tes[is.na(type), lgap := 0]
    tes[is.na(type), length := 0]
    
    tes <- merge(tes, te_data_rep, by.x = "name", by.y = "qseqid", all.x = T)
    tes_count <- nrow(tes)
    
    tes$pas <- unlist(lapply(stri_locate_all_regex(tes$seq, paste0(strrep("A", opt$min_polya), "|", strrep("T", opt$min_polya))), function(x) {min(unlist(x)) - 1}))
    tes$eas <- nchar(tes$seq) - unlist(lapply(stri_locate_all_regex(tes$seq, paste0(strrep("A", opt$min_polya), "|", strrep("T", opt$min_polya))), function(x) {max(unlist(x))}))
    tes[, pa := min(pas, eas), by = .I]
    tes[substr(seq, 1, 5) == "AAAAA" | substr(seq, 1, 5) == "TTTTT" | substr(seq, lente - 4, lente) == "AAAAA" | substr(seq, lente - 4, lente) == "TTTTT", pa := 0, by = .I]
    
    good_line <- tes[grepl("LINE", name) & orf1 > rules_cfg$line_min_orf &
                       (pa < rules_cfg$line_max_pa | tail3_len > 0 | is.na(type) |
                          (lgap > rules_cfg$line_inner_gap & rgap > rules_cfg$line_inner_gap))]$name
    
    # Find elements which share TIR or LTR to good ones.
    te_data_mix <- merge(te_data_mix,
                         tes[, c("name", "lente", "orf1", "orf2", "orf3", "cluster")]
                         [, name := gsub(">", "", name)], by.x = "qseqid",
                         by.y = "name")
    te_data_mix <- merge(te_data_mix,
                         tes[, c("name", "lente", "orf1", "orf2", "orf3", "cluster")]
                         [, name := gsub(">", "", name)], by.x = "sseqid",
                         by.y = "name")
    te_data_mix[, lqgap := .(min(qstart, qend) - 1), by = .I]
    te_data_mix[, rqgap := .(lente.x - max(qstart, qend)), by = .I]
    te_data_mix[, lsgap := .(min(sstart, send) - 1), by = .I]
    te_data_mix[, rsgap := .(lente.y - max(sstart, send)), by = .I]
    ## Remove dups
    te_data_mix[, cover := length / min(lente.x, lente.y), by = .I]
    te_data_dups <- te_data_mix[cover > rules_cfg$dup_cover & pident > rules_cfg$dup_ident &
                                  abs((lente.y - lente.x) / max(lente.y, lente.x)) < rules_cfg$dup_len_diff]
    te_data_dups[, uname := paste0(c(qseqid, sseqid)[order(c(qseqid, sseqid))], collapse = ""), .I]
    te_data_dups <- te_data_dups[order(cluster.x - cluster.y)]
    dups_list <- te_data_dups[!duplicated(te_data_dups$uname)]$qseqid
    te_data_mix <- te_data_mix[!(qseqid %in% dups_list)]
    te_data_mix <- te_data_mix[!(sseqid %in% dups_list)]
    
    ## 3'-anchored relatives: shorter elements that match the 3' end of a longer one, as
    ## 5'-truncated LINE copies do. Elements are oriented by their longest ORF, so the 3'
    ## end of the longer (container) element is its right end; the shorter one can be in
    ## either orientation, since its own longest ORF may be on the other strand. The
    ## container gets the number of such relatives, each relative the container's id.
    anch <- te_data_mix[lente.x < lente.y & length / lente.x >= rules_cfg$anchor_cover &
                          pident >= rules_cfg$anchor_ident &
                          pmax(sstart, send) >= lente.y - rules_cfg$anchor_end]
    tes[, `:=`(tr3_relatives = 0L, fragment_of = NA_character_)]
    if (nrow(anch) > 0) {
      rel <- anch[, .(n = uniqueN(qseqid)), by = sseqid]
      tes[rel, on = .(name = sseqid), tr3_relatives := i.n]
      frag <- anch[order(-lente.y)][, .SD[1], by = qseqid][, .(qseqid, container = gsub("#.*", "", sseqid))]
      tes[frag, on = .(name = qseqid), fragment_of := i.container]
    }
    lx(paste("Elements with 3'-anchored shorter relatives:", sum(tes$tr3_relatives > 0),
             "; elements that are 3' fragments of a longer one:", sum(!is.na(tes$fragment_of))))
    # A LINE whose 3' end is shared by truncated copies is supported even without a tail
    good_line <- union(good_line, tes[grepl("LINE", name) & orf1 > rules_cfg$line_min_orf & tr3_relatives > 0]$name)
    
    ## Containment: pairs where one hit of the longer element (big) covers at least
    ## contain_cover of the shorter one's (small) length at contain_ident or more.
    ## Applied at the very end, once it is known which elements are accepted.
    cp <- te_data_mix[lente.x != lente.y & pident >= rules_cfg$contain_ident]
    cp[, q_small := lente.x < lente.y]
    cp[, span := fifelse(q_small, abs(qend - qstart) + 1, abs(send - sstart) + 1) / pmin(lente.x, lente.y)]
    contain_pairs <- unique(cp[span >= rules_cfg$contain_cover,
                               .(small = gsub("#.*", "", fifelse(q_small, qseqid, sseqid)),
                                 big = gsub("#.*", "", fifelse(q_small, sseqid, qseqid)))])
    
    ### Find TIR elements that can be reclassified
    te_data_mix_tir <- te_data_mix[(qseqid %in% good_tir | sseqid %in% good_tir) &
                                     lsgap < rules_cfg$end_gap & rsgap < rules_cfg$end_gap &
                                     lqgap < rules_cfg$end_gap & rqgap < rules_cfg$end_gap]
    tir_reco1 <- te_data_mix_tir[!grepl("DNA", qseqid) & grepl("DNA", sseqid)]
    tir_reco2 <- te_data_mix_tir[!grepl("DNA", sseqid) & grepl("DNA", qseqid)]
    tir_reco <- data.table(name = c(tir_reco1$qseqid, tir_reco2$sseqid), sf = gsub(".*#", "", c(tir_reco1$sseqid, tir_reco2$qseqid)))
    tir_reco <- tir_reco[!duplicated(name)]          # one new class per element
    lx(paste("Unknown elements reclassified as DNA:", nrow(tir_reco)))
    tir_reco[, new := paste0(gsub("#.*", "", name), "#", sf)]
    tes[tir_reco, on = "name", name := i.new]
    
    ### Find LTR elements that can be reclassified
    te_data_mix_ltr <- te_data_mix[(qseqid %in% good_ltr | sseqid %in% good_ltr) &
                                     ((lsgap < rules_cfg$end_gap & rsgap < rules_cfg$end_gap) |
                                        (lqgap < rules_cfg$end_gap & rqgap < rules_cfg$end_gap))]
    ltr_reco1 <- te_data_mix_ltr[!grepl("LTR", qseqid) & grepl("LTR", sseqid)]
    ltr_reco2 <- te_data_mix_ltr[!grepl("LTR", sseqid) & grepl("LTR", qseqid)]
    ltr_reco <- data.table(name = c(ltr_reco1$qseqid, ltr_reco2$sseqid), sf = gsub(".*#", "", c(ltr_reco1$sseqid, ltr_reco2$qseqid)))
    ltr_reco <- ltr_reco[!duplicated(name)]          # one new class per element
    lx(paste("Unknown elements reclassified as LTR:", nrow(ltr_reco)))
    ltr_reco[, new := paste0(gsub("#.*", "", name), "#", sf)]
    tes[ltr_reco, on = "name", name := i.new]
    
    ### Putting all together
    # Remove the dups detected
    tes <- tes[!(name %in% dups_list)]
    lx(paste("Removed dups:", length(unique(dups_list))))
    # Every rule that accepts or rejects an element also records why (stats: reason).
    # Rules run in order and later ones overwrite earlier ones, so the reason is the
    # last rule that decided.
    tes[, `:=`(pass = F, reason = "no rule accepts it")]
    tes[, sf := gsub(".*#", "", name), by = .I]
    
    ### Terminal inverted repeats (replaces the old short_tir heuristic).
    # Only checked where BLAST found no structure, or found one away from the ends
    # (gap >= rules_cfg$tir_check_gap on either side). A significant terminal TIR then replaces the
    # structure call. Runs before every rule below that uses `type`.
    tes[, c("length", "lgap", "rgap") := lapply(.SD, as.numeric), .SDcols = c("length", "lgap", "rgap")]
    cand <- tes[, which(is.na(type) | lgap >= rules_cfg$tir_check_gap | rgap >= rules_cfg$tir_check_gap)]
    if (length(cand) > 0) {
      tir_res <- mclapply(tes$seq[cand], find_terminal_tir, mc.cores = opt$threads)
      check_tasks(tir_res, "TIR search", tes$name[cand])
      tir_res <- rbindlist(tir_res)
      sig <- which(tir_res$tir_p <= rules_cfg$tir_max_p)
      if (length(sig) > 0) {
        tes[cand[sig], `:=`(type = "TIR", length = tir_res$tir_len[sig],
                            lgap = tir_res$tir_lgap[sig], rgap = tir_res$tir_rgap[sig])]
      }
      lx(paste("Terminal TIRs detected:", length(sig), "of", length(cand), "elements checked"))
    }
    
    tes[name %in% good_line, `:=`(pass = T, reason = "LINE: long ORF, with a tail or no terminal repeat")]
    tes[grepl("DIRS", name) & (orf1 > rules_cfg$dirs_min_orf) & (lente < rules_cfg$dirs_max_len), `:=`(pass = T, reason = "DIRS: long ORF")]
    tes[grepl("Crypton", name), `:=`(pass = T, reason = "Crypton")]
    tes[grepl("#PLE", name), `:=`(pass = T, reason = "PLE")]
    tes[grepl("#SINE", name) & lente < rules_cfg$sine_max_len, `:=`(pass = T, reason = "SINE: short")]
    tes[name %in% good_ltr, `:=`(pass = T, reason = "LTR: terminal LTRs")]
    tes[name %in% ltr_reco$new, `:=`(pass = T, reason = "reclassified as LTR: matches an LTR element")]
    tes[name %in% good_tir, `:=`(pass = T, reason = "DNA: TIRs")]
    # DNA elements with a TIR near both ends, including TIRs found by the terminal-TIR
    # finder (good_tir only knows the BLAST calls made before that step)
    tes[grepl("#DNA", name) & type == "TIR" & lgap < rules_cfg$end_gap & rgap < rules_cfg$end_gap, `:=`(pass = T, reason = "DNA: TIRs")]
    tes[name %in% tir_reco$new, `:=`(pass = T, reason = "reclassified as DNA: matches a DNA element")]
    tes[grepl("#RC", name), `:=`(pass = T, reason = "RC")]
    ucut <- tryCatch(kneedle(tes[, .N, cluster]$cluster, tes[, .N, cluster]$N)[1],
                     error = function(e) NA)
    if (length(ucut) == 0 || is.na(ucut)) ucut <- rules_cfg$unknown_min_cluster
    lx(paste("Unknown recovery cutpoint:", ucut))
    tes[grepl("#Unknown", name) & cluster > max(rules_cfg$unknown_min_cluster, ucut), `:=`(pass = T, reason = "Unknown: large cluster")]
    # This should go at the end of the filters
    tes[is.na(pa), pa := 100]
    tes[, TR2 := maxRep > lente / rules_cfg$tandem_frac]
    tes[is.na(TR2), TR2 := F]
    tes[TR2 == T & type == "LTR" & maxRep > rules_cfg$tandem_ltr_max, `:=`(pass = F, reason = "LTR structure, mostly tandem repeat")]
    # Reclassification by TSDs
    tg_ca <- tes[, grepl("#Unknown", name) & substr(seq, 1, 2) == "TG" &
                   substr(seq, lente - 1, lente) == "CA" &
                   tsd_l >= rules_cfg$ltr_tsd_min & tsd_l <= rules_cfg$ltr_tsd_max & tsd_c > rules_cfg$tgca_tsd_conf]
    tes[tg_ca, `:=`(name = paste0(gsub("#.*", "", name), "#LTR"), pass = T,
                    reason = "Unknown to LTR: TG..CA ends and TSD")]
    lx(paste("Unknown elements reclassified as LTR by TG..CA termini and TSD:", sum(tg_ca)))
    
    tes[grepl("#Unknown", name) & type == "TIR" & lgap < rules_cfg$end_gap & rgap < rules_cfg$end_gap, `:=`(name = paste0(gsub("#.*", "", name), "#DNA"), pass = T,
        reason = "Unknown to DNA: TIRs"), by = .I]
    tes[grepl("#Unknown", name) & tsd_l >= rules_cfg$ltr_tsd_min & tsd_l <= rules_cfg$ltr_tsd_max &
        tsd_c > rules_cfg$unknown_tsd_conf & type == "LTR" & length > rules_cfg$unknown_ltr_min_len &
        lgap < rules_cfg$end_gap & rgap < rules_cfg$end_gap & TR2 == F, `:=`(name = paste0(gsub("#.*", "", name), "#LTR"), pass = T,
        reason = "Unknown to LTR: terminal LTRs and TSD"), by = .I]
    # SINE reclassification by pA and size. TO UPDATE WITH HOMOLOGY SEARCH
    tes[grepl("#Unknown", name) & lente < rules_cfg$sine_reco_max_len & pa < rules_cfg$sine_reco_max_pa & !is.na(pa), `:=`(name = paste0(gsub("#.*", "", name), "#SINE"), pass = T,
        reason = "Unknown to SINE: short, with polyA"), by = .I]
    tes$Ns <- nchar(tes$seq) - nchar(gsub("N", "", tes$seq))
    tes[Ns > (nchar(seq) * opt$max_cons_ns), `:=`(pass = F, reason = "too many Ns")]
    tes[grepl("#LINE", name) & TR2 == T, `:=`(pass = F, reason = "LINE, mostly a repeat of itself (maxTR)")]
    
  } else {
    tes[, name := gsub(">", "", name)]
    tes[, `:=`(pass = FALSE, reason = "no self-BLAST hits", type = NA_character_, length = 0, lgap = 0, rgap = 0,
               pa = NA_real_, maxRep = NA_real_, tr3_relatives = 0L, fragment_of = NA_character_,
               Ns = nchar(seq) - nchar(gsub("N", "", seq)))]
    lx("No self-BLAST hits: structural checks skipped")
  }
  unlink(temp, recursive = TRUE)
  tes <- tes[order(-lente)]
  
  ### Final names, built from the final class and numbered by length within each class:
  ### <class>_<n>-<lib>#<class/subclass>. Alignments are renamed to match.
  tes[, work_id := gsub("#.*", "", name)]
  tes[, cls := gsub(".*#", "", name)]
  tes[, short_cls := gsub(".*/", "", cls)]
  tes[, ix := seq_len(.N), by = short_cls]
  tes[, name := paste0(short_cls, "_", ix, "-", opt$lib_name, "#", cls)]
  tes[, fragment_of := name[match(fragment_of, work_id)]]   # container id -> final name
  for (k in seq_len(nrow(tes))) {
    old_aln <- outf("alignments", tes$aln_file[k])
    if (file.exists(old_aln)) {
      new_aln <- outf("alignments", paste0(make.names(tes$name[k]), ".maf"))
      file.rename(old_aln, new_aln)
      if (isTRUE(tes$flipped[k])) rc_alignment(new_aln)   # match the library orientation
    }
  }
  tes[, name := paste0(">", name)]
  
  gtab <- rbindlist(lapply(tes$gencount, function(x) {getgenomes(x, genomes)}))
  gmax <- apply(gtab, 1, max)
  tes[gmax < opt$min_copies, `:=`(pass = F, reason = "too few copies in every genome (-e)")]
  ## Contained elements: an element covered over most of its length, at high identity,
  ## by one hit of a longer accepted LINE, LTR, PLE or RC element is redundant and is
  ## rejected. This is the last decision, so no rule can accept it again. Containers
  ## are taken from the longest down; an element rejected here rejects no others.
  if (nrow(contain_pairs) > 0) {
    top_cls <- gsub("/.*", "", gsub(".*#", "", tes$name))
    n_contained <- 0
    for (b in tes$work_id[tes$pass & top_cls %in% rules_cfg$contain_classes]) {   # tes is sorted by length
      bi <- which(tes$work_id == b)
      if (!tes$pass[bi]) next
      inside <- which(tes$work_id %in% contain_pairs[big == b]$small & tes$pass)
      if (length(inside) > 0) {
        tes[inside, `:=`(pass = F, reason = paste("contained in", sub("^>", "", tes$name[bi])))]
        n_contained <- n_contained + length(inside)
      }
    }
    lx(paste("Elements rejected as contained in a longer accepted LINE, LTR, PLE or RC element:", n_contained))
  }
  lx(paste("Elements accepted:", nrow(tes[pass == TRUE]), "; rejected:", nrow(tes[pass == FALSE])))
  # The library holds the accepted elements; the rejected ones go to their own file
  # (their reasons are in the stats file, which lists both)
  wfasta(tes[pass == T, c("name", "seq")], outf(paste0(opt$lib_name, "-pantera-final.fa")))
  wfasta(tes[pass == F, c("name", "seq")], outf(paste0(opt$lib_name, "-pantera-rejected.fa")))
  stats_data <- tes[, c("name", "lente", "pass", "reason", "hom_class", "hom_prob", "cluster", "tsd_l", "tsd_c", "tsd_m",
                        "tsd_p", "gencount", "type", "length", "lgap", "rgap", "pa", "tail3_motif", "tail3_len",
                        "tail5_motif", "tail5_len", "tr3_relatives", "fragment_of",
                        "orf1", "orf2", "orf3", "maxRep", "Ns")]
  ### Last fixes
  stats_data[tsd_m == "" | is.na(tsd_m), tsd_c := 0]
  stats_data$pa <- stats_data$pa < opt$min_polya
  
  colnames(stats_data) <- c("name", "TE_len", "pass", "reason", "homology_class", "homology_prob", "cluster_size",
                            "TSD_length", "TSD_confidence", "TSD_motif", "TSD_pvalue",
                            "gen_count", "struct_type", "struct_len", "left_gap",
                            "right_gap", "polyA", "tail3_motif", "tail3_len", "tail5_motif", "tail5_len",
                            "tr3_relatives", "fragment_of", "orf1", "orf2", "orf3", "maxTR", "Ns")
  
  stats_data <- cbind(stats_data, gtab)
  stats_data[,name:=gsub("^>","",name)]
  stats_data$gen_count <- apply(gtab, 1, function(x) {sum(x > 0)})
  fwrite(stats_data, outf(paste0(opt$lib_name, "-pantera-final.stats.tsv")),
         quote = F, row.names = F, sep = "\t")
}


produce_annotation <- function() {
  lx("Obtaining annotations")
  lib_fa <- outf(paste0(opt$lib_name, "-pantera-final.fa"))
  db <- outf("anno", "pan")
  dir.create(outf("anno"))
  system(paste0("makeblastdb -in ", shQuote(outf("pantera_lib_0.fa")), " -out ", shQuote(db),
                " -dbtype nucl 1> /dev/null"))
  te_data <- fread(cmd= paste0("blastn -query ", shQuote(lib_fa), " -db ", shQuote(db),
                               " -task blastn -num_threads ", opt$threads, " -mt_mode 1",
                               " -evalue 500 -outfmt 6"), header = F)
  polys <- ffasta(lib_fa)
  polys[,l:=nchar(seq)]
  polys$seq <- NULL
  polys[,name:=gsub(">","",name)]
  te_data <- merge(te_data,polys,  by.x="V1", by.y ="name")
  te_data[,p:=V4/l]
  te_data <- te_data[(p>=opt$anno_coverage) & (V3>= 100*opt$anno_identity)]
  te_data[,start:=gsub("-.*","",gsub(".*:","",V2))]
  te_data[,end:=gsub(".*-","",V2)]
  te_data[,l2:=as.numeric(end)-as.numeric(start)]
  te_data[,d2:=l2/l]
  te_data <- te_data[d2>= opt$anno_identity & d2<= (2-opt$anno_identity)]
  annotations <- te_data[order(-V4),.(names = paste(V1, collapse = " | ")), V2]
  annotations[,gen:=gsub("#.*","",V2)]
  annotations[,chr:=gsub(":.*","",gsub(".*#","",V2))]
  annotations[,start:=gsub("-.*","",gsub(".*:","",V2))]
  annotations[,end:=gsub(".*-","",V2)]
  dir.create(outf("annotations"))
  lapply(unique(annotations$gen), function(x) {fwrite(annotations[gen==x,c("chr","start","end", "names")], outf("annotations", paste0(x, ".bed")), col.names = F, sep ="\t")})
  unlink(outf("anno"), recursive=TRUE)
}

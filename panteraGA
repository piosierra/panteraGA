### MAIN 
###

# Globals, set here only and read by the functions:
#   opt         options (read_pars)
#   genomes     genome file names without folders, in the order of the list
#   seg_flanks  flank lengths of every segment (read_poly), used by seg_flank_lengths
# All files are written in the output folder (outf); the working directory never changes.

invisible(tryCatch({get_libs()}, error = function(err) {
  end_pantera(paste("Installing libs error ->",geterrmessage()))
}))
invisible(tryCatch({opt <- read_pars()}, error = function(err) {
  end_pantera(paste("Reading parameters error ->",geterrmessage()))
}))
invisible(tryCatch({init_pantera()}, error = function(err) {
  end_pantera(paste("Initialization error ->",geterrmessage()))
}))

# Reproducible runs. The TIR test seeds each element from its own sequence and
# --seed (seq_seed); this generator also gives any other random draw in a
# parallel task its own reproducible stream.
RNGkind("L'Ecuyer-CMRG")
set.seed(opt$seed)

seg_flanks <- data.table(name = character(), lx = numeric(), rx = numeric())

invisible(tryCatch({genome_paths <- make_alignments(opt$genomes)}, error = function(err) {
  end_pantera(paste("Alignments error ->",geterrmessage()))
}))

genomes <- basename(genome_paths)

invisible(tryCatch({seg_flanks <- read_poly(genomes)}, error = function(err) {
  end_pantera(paste("Error reading polymorphisms ->",geterrmessage()))
}))

invisible(tryCatch({find_repeats()}, error = function(err) {
  end_pantera(paste("Error round 1 ->",geterrmessage()))
}))

invisible(tryCatch({cluster_results()}, error = function(err) {
  end_pantera(paste("Error round 2 ->",geterrmessage()))
}))
invisible(tryCatch({final <- classify_tes()}, error = function(err) {
  end_pantera(paste("Error Classification ->",geterrmessage()))
}))
invisible(tryCatch({stats_tes(final, genomes)}, error = function(err) {
  end_pantera(paste("Error Stats ->",geterrmessage()))
}))
invisible(tryCatch({produce_annotation()}, error = function(err) {
  end_pantera(paste("Error Annotation ->",geterrmessage()))
}))
if (opt$debug == FALSE) {
  invisible(tryCatch({cleanup()}, error = function(err) {
    end_pantera(paste("Error cleaning up ->",geterrmessage()))
  }))
} else {
  lx(paste0(   "\u001b[32;2m",
               "\u263A",
               "\u001b[0m : ","End of process."))
}




